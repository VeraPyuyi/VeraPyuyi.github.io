---
import { getCollection, render } from 'astro:content';
import CustomContent from '@components/common/CustomContent.astro';
import { Icon } from 'astro-icon/components';
import PageChrome from '@/components/personal/PageChrome.astro';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
const en = locale === 'en';
const projects = (await getCollection('projects'))
  .filter((entry) => entry.data.language === 'zh' || entry.data.language === locale)
  .sort((a, b) => b.data.order - a.data.order);
const rendered = await Promise.all(projects.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const statusText = {
  idea: en ? 'Idea' : '构思中',
  active: en ? 'Active' : '进行中',
  maintained: en ? 'Maintained' : '维护中',
  archived: en ? 'Archived' : '已归档',
};
---

<PageChrome locale={locale} title={en ? 'Projects' : '项目'} description={en ? 'Experiments, open-source work, and links to future project sub-sites.' : '记录实验、开源作品，以及未来独立发布的项目子站。'}>
  <div class="grid gap-5 lg:grid-cols-2" data-pagefind-body>
    {rendered.map(({ entry, Content }) => (
      <article class="group overflow-hidden rounded-3xl border border-black/5 bg-white/55 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:shadow-xl motion-reduce:transform-none dark:border-white/10 dark:bg-white/5">
        {entry.data.cover && <ResponsiveImage src={entry.data.cover} alt={`${entry.data.name} ${en ? 'cover' : '封面'}`} class="aspect-[16/8] w-full object-cover" sizes="(min-width: 1024px) 50vw, 100vw" />}
        <div class="space-y-4 p-6">
          <div class="flex items-start justify-between gap-3">
            <div><h2 class="text-xl font-bold">{entry.data.name}</h2><p class="text-muted-foreground mt-1 text-sm leading-6">{entry.data.description}</p></div>
            <span class="bg-primary/10 text-primary shrink-0 rounded-full px-3 py-1 text-xs font-semibold">{statusText[entry.data.status]}</span>
          </div>
          <div class="flex flex-wrap gap-2">{entry.data.tags.map((tag) => <span class="bg-black/5 rounded-full px-2.5 py-1 text-xs dark:bg-white/10">{tag}</span>)}</div>
          <div class="prose prose-sm dark:prose-invert"><CustomContent Content={Content} /></div>
          <div class="flex flex-wrap gap-3 text-sm font-semibold">
            {entry.data.repository && <a class="text-primary inline-flex items-center gap-1 hover:underline" href={entry.data.repository} target="_blank" rel="noreferrer"><Icon name="ri:github-fill" />{en ? 'Source' : '源码'}</a>}
            {entry.data.demo && <a class="text-primary inline-flex items-center gap-1 hover:underline" href={entry.data.demo} target="_blank" rel="noreferrer"><Icon name="ri:external-link-line" />{en ? 'Visit' : '访问'}</a>}
          </div>
        </div>
      </article>
    ))}
  </div>
</PageChrome>
