---
import { getCollection } from 'astro:content';
import PageChrome from '@/components/personal/PageChrome.astro';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
const en = locale === 'en';
const albums = (await getCollection('albums'))
  .filter((entry) => entry.data.language === 'zh' || entry.data.language === locale)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
// Hoag's Object: every photo becomes a knot on the ring around the old yellow core, at most twelve.
const ringPhotos = albums.flatMap((album) => album.data.photos).slice(0, 12);
---

<PageChrome locale={locale} sky="photos" title={en ? 'Photo Wall' : '照片墙'} description={en ? 'When the shutter closes, the light finally has somewhere to stay.' : '快门落下的那一刻，光终于有了去处。'}>
  <div slot="art" class="hoag">
    <img class="hoag-sky" src="/img/sky/photos-hero.webp" alt="" width="1200" height="1043" decoding="async" />
    <div class="hoag-orbit">
      {ringPhotos.map((photo, index) => (
        <button
          type="button"
          class="photo-trigger hoag-photo"
          style={`--angle:${(-90 + (index * 360) / ringPhotos.length).toFixed(1)}deg`}
          data-src={photo.src}
          data-alt={photo.alt}
          aria-label={photo.alt}
        >
          <ResponsiveImage src={photo.src} alt="" sizes="6rem" class="size-full object-cover" pictureClass="size-full" />
        </button>
      ))}
    </div>
  </div>
  <p slot="meta">{en ? `${ringPhotos.length} on the ring · each new photo lights another knot` : `环上 ${ringPhotos.length} 张 · 每多一张照片，环上就多亮一处`}</p>
  <div class="space-y-10" data-pagefind-body>
    {albums.map((album) => (
      <section class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><h2 class="text-2xl font-bold">{album.data.name}</h2>{album.data.description && <p class="text-muted-foreground mt-1 text-sm">{album.data.description}</p>}</div>
          {album.data.date && <time class="text-muted-foreground text-xs" datetime={album.data.date.toISOString()}>{new Intl.DateTimeFormat(en ? 'en' : 'zh-CN', { dateStyle: 'long' }).format(album.data.date)}</time>}
        </div>
        <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
          {album.data.photos.map((photo, index) => (
            <button type="button" class="photo-trigger group relative mb-4 block w-full cursor-zoom-in overflow-hidden rounded-3xl bg-black/5 text-left shadow-sm" data-src={photo.src} data-alt={photo.alt} data-index={index}>
              <ResponsiveImage src={photo.src} alt={photo.alt} class="w-full object-cover transition duration-500 group-hover:scale-[1.025] motion-reduce:transition-none" />
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-4 pb-3 pt-10 text-xs text-white opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100">{photo.alt}</span>
            </button>
          ))}
        </div>
      </section>
    ))}
  </div>
  <dialog id="gallery-lightbox" class="m-auto max-h-[92vh] max-w-[94vw] rounded-3xl bg-transparent p-0 backdrop:bg-black/85">
    <div class="relative overflow-hidden rounded-3xl bg-black p-2 shadow-2xl">
      <button type="button" data-close class="absolute right-4 top-4 z-10 flex size-10 items-center justify-center rounded-full bg-black/55 text-xl text-white" aria-label={en ? 'Close' : '关闭'}>×</button>
      <img data-lightbox-image src="" alt="" class="max-h-[86vh] max-w-[90vw] rounded-2xl object-contain" />
      <p data-lightbox-caption class="absolute inset-x-5 bottom-5 rounded-2xl bg-black/55 px-4 py-2 text-center text-sm text-white backdrop-blur"></p>
    </div>
  </dialog>
</PageChrome>

<style>
  .hoag {
    position: relative;
    width: min(54vw, 46rem);
    aspect-ratio: 1200 / 1043;
    animation: hoag-float 16s ease-in-out infinite;
  }

  .hoag-sky {
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(closest-side, #000 72%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 72%, transparent 100%);
  }

  /* A square orbit centred on the core; it turns once every four minutes, the photos stay upright. */
  .hoag-orbit {
    position: absolute;
    top: 55.6%;
    left: 50.8%;
    width: 69%;
    aspect-ratio: 1;
    translate: -50% -50%;
    animation: hoag-turn 240s linear infinite;
  }

  .hoag-photo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(3.2rem, 6.5vw, 5.4rem);
    aspect-ratio: 1;
    margin: calc(clamp(3.2rem, 6.5vw, 5.4rem) / -2);
    overflow: hidden;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px rgb(255 255 255 / 0.75),
      0 0 22px rgb(170 190 255 / 0.85),
      0 0 60px rgb(150 170 255 / 0.45);
    cursor: zoom-in;
    pointer-events: auto;
    transform: rotate(var(--angle)) translateX(calc(min(54vw, 46rem) * 0.345)) rotate(calc(var(--angle) * -1));
    transition: box-shadow 0.4s ease;
  }

  .hoag-photo > :global(picture) {
    animation: hoag-turn 240s linear infinite reverse;
  }

  .hoag-photo:hover,
  .hoag-photo:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #fff,
      0 0 28px rgb(255 214 240 / 0.95),
      0 0 80px rgb(247 168 200 / 0.6);
  }

  .hoag:has(.hoag-photo:hover) :is(.hoag-orbit, .hoag-photo > :global(picture)) {
    animation-play-state: paused;
  }

  @keyframes hoag-turn {
    to {
      rotate: 360deg;
    }
  }

  @keyframes hoag-float {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -1.2%;
    }
  }

  @media (max-width: 768px) {
    .hoag {
      width: calc(100vw - 2.5rem);
    }

    .hoag-photo {
      transform: rotate(var(--angle)) translateX(calc((100vw - 2.5rem) * 0.345)) rotate(calc(var(--angle) * -1));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hoag,
    .hoag-orbit,
    .hoag-photo > :global(picture) {
      animation: none;
    }
  }
</style>

<script>
  function installGallery() {
    const dialog = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = 'true';
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    document.querySelectorAll<HTMLButtonElement>('.photo-trigger').forEach((button) => {
      button.addEventListener('click', () => {
        if (!image || !caption) return;
        image.src = button.dataset.src ?? '';
        image.alt = button.dataset.alt ?? '';
        caption.textContent = button.dataset.alt ?? '';
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  }
  installGallery();
  document.addEventListener('astro:page-load', installGallery);
</script>
