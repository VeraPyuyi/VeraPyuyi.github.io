---
import { getCollection, render } from 'astro:content';
import CustomContent from '@components/common/CustomContent.astro';
import { Icon } from 'astro-icon/components';
import PageChrome from '@/components/personal/PageChrome.astro';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import MoonGlyph from '@/components/sky/MoonGlyph.astro';
import { defaultLocale } from '@/i18n';
import { MOON_PHASE_NAMES, MOON_PHASE_NAMES_EN, moonPhase } from '@/lib/galaxy';

interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
const en = locale === 'en';
const moments = (await getCollection('moments'))
  .filter((entry) => !entry.data.draft && (entry.data.language === 'zh' || entry.data.language === locale))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const rendered = await Promise.all(moments.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
---

<PageChrome locale={locale} sky="moments" title={en ? 'Moments' : '生活动态'} description={en ? 'Days too small for an essay still deserve a quiet line.' : '撑不起一篇文章的日子，也值得被轻轻记下一行。'}>
  <ol class="relative ml-3 space-y-8 border-l border-pink-300/70 pl-8 dark:border-pink-400/25" data-pagefind-body>
    {rendered.map(({ entry, Content }) => (
      <li class="relative">
        {/* The timeline is a run of moons: each moment is marked by the moon of the night it was written. */}
        <MoonGlyph date={entry.data.date} locale={locale} class="moments-moon absolute -left-[2.62rem] top-0.5 size-[1.1rem]" />
        <article class="rounded-3xl border border-black/5 bg-white/55 p-6 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/5">
          <div class="text-muted-foreground mb-4 flex flex-wrap items-center gap-3 text-xs">
            <time datetime={entry.data.date.toISOString()}>{new Intl.DateTimeFormat(en ? 'en' : 'zh-CN', { dateStyle: 'long', timeStyle: 'short' }).format(entry.data.date)}</time>
            <span class="moments-moon-name">{(en ? MOON_PHASE_NAMES_EN : MOON_PHASE_NAMES)[moonPhase(entry.data.date.getTime()).index]}{en ? '' : '之夜'}</span>
            {entry.data.location && <span class="inline-flex items-center gap-1"><Icon name="ri:map-pin-2-line" />{entry.data.location}</span>}
          </div>
          <div class="prose dark:prose-invert"><CustomContent Content={Content} /></div>
          {entry.data.photos.length > 0 && <div class="mt-5 grid gap-3 sm:grid-cols-2">{entry.data.photos.map((photo) => <ResponsiveImage src={photo.src} alt={photo.alt} class="aspect-[4/3] w-full rounded-2xl object-cover" />)}</div>}
        </article>
      </li>
    ))}
  </ol>
</PageChrome>
