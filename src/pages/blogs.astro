---
import BlogList from '@/components/personal/BlogList.astro';
import PageChrome from '@/components/personal/PageChrome.astro';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const en = locale === 'en';
---

<PageChrome
  locale={locale}
  title={en ? 'Blogs' : '博客'}
  description={en ? 'Personal blogs, themed sites, and links to their source code.' : '收集个人博客、专题站点，以及对应的源码与访问入口。'}
>
  <BlogList locale={locale} />
</PageChrome>
