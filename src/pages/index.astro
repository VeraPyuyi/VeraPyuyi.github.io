---
import { seoConfig, siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import GalaxyFlight from '@/components/home/GalaxyFlight.astro';
import { defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
}

// Root pages render the default locale; `[lang]/` mirrors pass their locale in explicitly.
const { locale = defaultLocale } = Astro.props;
const browserTitle = 'Pyuyi’s Home';
---

<Layout
  locale={locale}
  title={browserTitle}
  openGraph={{
    title: seoConfig.title,
    image: siteConfig.homeOgImage,
    imageAlt:
      locale === 'en'
        ? 'The Whirlpool Galaxy (M51) glowing in deep space, captioned: this light set out before there were humans on Earth'
        : '涡状星系 M51 在深空中发光，配文：这束光出发的时候，地球上还没有人类',
  }}
>
  <GalaxyFlight locale={locale} />
</Layout>
