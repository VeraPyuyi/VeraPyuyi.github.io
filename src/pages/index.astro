---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { seoConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { Icon } from 'astro-icon/components';
import BlogList from '@/components/personal/BlogList.astro';
import FeatureHub from '@/components/personal/FeatureHub.astro';
import PaperList from '@/components/personal/PaperList.astro';
import Divider from '@/components/ui/divider';
import { defaultLocale, localizedPath } from '@/i18n';

interface Props {
  locale?: string;
}

// Root pages render the default locale; `[lang]/` mirrors pass their locale in explicitly.
const { locale = defaultLocale } = Astro.props;
const en = locale === 'en';
const browserTitle = 'Pyuyi’s Home';
---

<Layout locale={locale} title={browserTitle} openGraph={{ title: seoConfig.title }}>
  <TwoColumnLayout>
    <Cover slot="cover" />
    <HomeSider slot="sider" />
    <div
      class={`bg-gradient-start shadow-box tablet:shadow-none flex flex-col gap-4 overflow-hidden  ${CONTENT_PADDING.standard}`}
    >
      <FeatureHub locale={locale} />
      <Divider>{en ? 'Latest papers' : '近期论文'}</Divider>
      <PaperList locale={locale} limit={3} indexable={false} />
      <a
        class="text-primary ml-auto inline-flex items-center gap-1 text-sm font-semibold hover:underline"
        href={localizedPath('/papers', locale)}
      >
        {en ? 'View all papers' : '查看全部论文'}
        <Icon name="ri:arrow-right-line" />
      </a>
      <Divider>{en ? 'Blogs' : '博客'}</Divider>
      <BlogList locale={locale} limit={3} indexable={false} />
      <a
        class="text-primary ml-auto inline-flex items-center gap-1 text-sm font-semibold hover:underline"
        href={localizedPath('/posts', locale)}
      >
        {en ? 'View all posts' : '查看全部文章'}
        <Icon name="ri:arrow-right-line" />
      </a>
    </div>
  </TwoColumnLayout>
</Layout>
