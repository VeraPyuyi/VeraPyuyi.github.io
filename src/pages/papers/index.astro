---
import { Icon } from 'astro-icon/components';
import PageChrome from '@/components/personal/PageChrome.astro';
import { defaultLocale, localizedPath } from '@/i18n';
import { getPapers } from '@/lib/papers';

interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
const en = locale === 'en';
const papers = getPapers();
---

<PageChrome locale={locale} title={en ? 'Papers & Notes' : '论文与笔记'} description={en ? 'Full LaTeX sources compiled into semantic HTML/MathML and a downloadable PDF.' : '完整 LaTeX 源文档同时编译为语义化 HTML/MathML 与可下载 PDF。'}>
  <div class="space-y-5" data-pagefind-body>
    {papers.map((paper) => (
      <article class="grid overflow-hidden rounded-3xl border border-black/5 bg-white/55 shadow-sm backdrop-blur md:grid-cols-[15rem_1fr] dark:border-white/10 dark:bg-white/5">
        <img src={paper.cover ?? '/og.png'} alt="" class="h-full min-h-48 w-full object-cover" loading="lazy" />
        <div class="space-y-4 p-6">
          <div class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-2 text-xs"><time datetime={paper.date}>{paper.date}</time><span>{paper.authors.join(', ')}</span></div>
          <div><h2 class="text-xl font-bold"><a class="hover:text-primary" href={localizedPath(`/papers/${paper.id}`, locale)}>{en && paper.titleEn ? paper.titleEn : paper.title}</a></h2><p class="text-muted-foreground mt-2 text-sm leading-6">{en && paper.abstractEn ? paper.abstractEn : paper.abstract}</p></div>
          <div class="flex flex-wrap gap-2">{paper.keywords.map((keyword) => <span class="bg-primary/10 text-primary rounded-full px-2.5 py-1 text-xs">{keyword}</span>)}</div>
          <a class="text-primary inline-flex items-center gap-1 text-sm font-semibold hover:underline" href={localizedPath(`/papers/${paper.id}`, locale)}><Icon name="ri:book-read-line" />{en ? 'Read HTML and download PDF' : '阅读 HTML 并下载 PDF'}</a>
        </div>
      </article>
    ))}
  </div>
</PageChrome>
