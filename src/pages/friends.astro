---
import FriendRequestForm from '@components/friends/FriendRequestForm';
import FriendsGrid from '@components/friends/FriendsGrid';
import { friendSources } from '@constants/friends-config';
import { loadFriends } from '@lib/friends/load';
import { siteConfig } from '@constants/site-config';
import { Comment } from '@/components/comment';
import LocalGroup from '@/components/sky/LocalGroup.astro';
import SkyPage from '@/components/sky/SkyPage.astro';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}

// Root pages render the default locale; `[lang]/` mirrors pass their locale in explicitly.
const { locale = defaultLocale } = Astro.props;
const en = locale === 'en';
const heading = t(locale, 'friends.title');
// Configured friends plus applications approved in this page's comments.
const { friends } = await loadFriends(friendSources);
---

<SkyPage
  locale={locale}
  title={`${heading} | ${siteConfig.title}`}
  heading={heading}
  env="group"
  plate={en ? `Local Group · ${friends.length + 1} galaxies` : `本星系群 · ${friends.length + 1} 个星系`}
  description={
    en
      ? 'Galaxies are rarely alone: the ones close enough feel each other’s pull and drift through the dark together.'
      : '星系很少独自存在。离得够近的，会感到彼此的引力，在黑暗里结伴漂流。'
  }
>
  <LocalGroup slot="art" friends={friends} locale={locale} />
  <div class="flex flex-col gap-12">
    <FriendsGrid friends={friends} locale={locale} client:load />
    <div>
      <FriendRequestForm locale={locale} client:visible />
      <div id="friend-comments" class="scroll-mt-24">
        <Comment contentId="page:friends" />
      </div>
    </div>
  </div>
</SkyPage>
