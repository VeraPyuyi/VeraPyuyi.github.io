---
/**
 * The sky behind an inner page: a particle nebula taller than the screen (src/lib/sky-nebula.ts,
 * painted once onto a canvas) and three layers of stars. As the page scrolls they glide past at
 * different depths, so the surroundings travel with the reader. Only composited layers move.
 */
import { starLayers } from '@/lib/sky-nebula';
import type { SkyEnvironment } from '@/lib/sky-catalog';

interface Props {
  env: SkyEnvironment;
}

const { env } = Astro.props;
const stars = starLayers(env);
---

<div class="sky-backdrop" data-env={env} data-sky-backdrop aria-hidden="true">
  <div class="sky-nebula">
    <canvas class="sky-nebula-field" width="1600" height="2600" data-sky-nebula></canvas>
  </div>
  {
    stars.map((layer, index) => (
      <span class={`sky-stars sky-stars-${index}`} style={`box-shadow:${layer.shadow};--depth:${layer.depth}vh`} />
    ))
  }
</div>

<script>
  import type { SkyEnvironment } from '@/lib/sky-catalog';
  import { paintNebula } from './nebula-canvas';

  // The nebula is painted once per page, after the page has settled.
  let stopPaint: (() => void) | null = null;
  function paintSky() {
    stopPaint?.();
    const backdrop = document.querySelector<HTMLElement>('[data-sky-backdrop]');
    const canvas = backdrop?.querySelector<HTMLCanvasElement>('[data-sky-nebula]');
    if (!backdrop || !canvas || canvas.classList.contains('is-painted')) return;
    const start = () => {
      stopPaint = paintNebula(canvas, backdrop.dataset.env as SkyEnvironment);
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 600 });
    else window.setTimeout(start, 120);
  }

  // The surroundings travel with the reader: as the page scrolls, the nebula field and the star
  // layers glide upwards at their own depths (CSS reads --sky-progress, 0 at the top, 1 at the end).
  let frame = 0;
  function paint() {
    frame = 0;
    const backdrop = document.querySelector<HTMLElement>('[data-sky-backdrop]');
    if (!backdrop) return;
    const travel = document.documentElement.scrollHeight - window.innerHeight;
    backdrop.style.setProperty('--sky-progress', (travel > 0 ? Math.min(1, window.scrollY / travel) : 0).toFixed(4));
  }
  const onScroll = () => {
    if (!frame) frame = requestAnimationFrame(paint);
  };
  function init() {
    if (!document.querySelector('[data-sky-backdrop]')) return;
    paintSky();
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
  if (document.readyState !== 'loading') init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    stopPaint?.();
    stopPaint = null;
    window.removeEventListener('scroll', onScroll);
    window.removeEventListener('resize', onScroll);
  });
</script>
