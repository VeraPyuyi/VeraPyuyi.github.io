---
/**
 * The sky behind an inner page. A field of nebulae taller than the screen and three layers of
 * stars stay behind the reading panel; as the page scrolls they glide past at different depths,
 * so the surroundings travel with the reader. Each page's sky is a different kind of nebula:
 * emission clouds broken by dark dust, reflection haze round spiked stars, planetary rings,
 * cirrus filaments, a black hole's jets, the Milky Way, a supernova shell, far galaxies.
 * Clouds are fractal noise (SVG feTurbulence), tinted, and shaped by soft masks.
 */
import { createRandom } from '@/lib/galaxy-flight/particles';
import type { SkyEnvironment } from '@/lib/sky-catalog';

interface Props {
  env: SkyEnvironment;
}

interface Cloud {
  /** Centre and half-size in the 1600 × 2600 field. */
  x: number;
  y: number;
  rx: number;
  ry: number;
  color: string;
  /** Noise scale: smaller gives larger wisps. */
  frequency: number;
  strength: number;
  seed: number;
  turn?: number;
  /** `filament` draws the noise's veins (cirrus, shock fronts); `dust` darkens instead of glowing. */
  kind?: 'haze' | 'filament' | 'dust';
  /** `ring` keeps only a band round the centre (planetary nebulae, supernova shells). */
  shape?: 'ellipse' | 'ring';
}

type Spot = [x: number, y: number, rx: number, ry: number];
const C = (
  [x, y, rx, ry]: Spot,
  color: string,
  frequency: number,
  strength: number,
  seed: number,
  extra: Partial<Cloud> = {},
): Cloud => ({ x, y, rx, ry, color, frequency, strength, seed, ...extra });

interface Environment {
  /** Colours of the soft haze that runs down both sides of the page. */
  haze: string[];
  /** The environment's signature clouds, drawn over the haze. */
  clouds: Cloud[];
  sparkles?: number;
  galaxies?: number;
}

const ENVIRONMENTS: Record<SkyEnvironment, Environment> = {
  // M51: glowing hydrogen clouds, torn by lanes of dark dust.
  rose: {
    haze: ['#db2777', '#7c3aed', '#be185d'],
    clouds: [
      C([121, 420, 525, 400], '#f472b6', 0.0032, 0.8, 3),
      C([138, 470, 450, 275], '#0b0614', 0.006, 0.9, 5, { kind: 'dust', turn: 20 }),
      C([1490, 980, 550, 425], '#a855f7', 0.003, 0.75, 11),
      C([121, 1560, 475, 325], '#ec4899', 0.007, 0.8, 7, { kind: 'filament', turn: -15 }),
      C([1479, 2150, 525, 400], '#f472b6', 0.0034, 0.7, 13),
      C([1468, 2180, 425, 225], '#0b0614', 0.0065, 0.85, 17, { kind: 'dust', turn: -25 }),
    ],
  },
  // NGC 1300: blue reflection haze round bright young stars, warmed by gold dust.
  gold: {
    haze: ['#0ea5e9', '#d97706', '#0d9488'],
    clouds: [
      C([1490, 380, 500, 400], '#7dd3fc', 0.0022, 0.7, 21),
      C([121, 1050, 525, 375], '#f5b45a', 0.0035, 0.65, 23),
      C([1479, 1720, 475, 375], '#5eead4', 0.0025, 0.6, 25),
      C([132, 2280, 500, 350], '#fbbf24', 0.0035, 0.55, 27),
    ],
    sparkles: 7,
  },
  // Hoag's Object: planetary nebulae, rings of glowing gas round dying stars.
  ring: {
    haze: ['#2563eb', '#0891b2', '#4f46e5'],
    clouds: [
      C([1479, 520, 475, 475], '#2dd4bf', 0.004, 0.85, 31, { shape: 'ring' }),
      C([1479, 520, 375, 375], '#60a5fa', 0.0025, 0.5, 33),
      C([127, 1350, 300, 300], '#93c5fd', 0.005, 0.85, 35, { shape: 'ring' }),
      C([1490, 2150, 425, 425], '#fb7185', 0.0045, 0.8, 37, { shape: 'ring' }),
      C([1490, 2150, 275, 275], '#67e8f9', 0.003, 0.55, 39),
    ],
  },
  // The Small Magellanic Cloud: long cirrus veils.
  cloud: {
    haze: ['#0891b2', '#7c3aed', '#db2777'],
    clouds: [
      C([143, 420, 650, 225], '#67e8f9', 0.006, 0.85, 41, { kind: 'filament', turn: 32 }),
      C([1468, 1100, 650, 212], '#c4b5fd', 0.0055, 0.85, 43, { kind: 'filament', turn: -28 }),
      C([143, 1780, 600, 200], '#f9a8d4', 0.006, 0.8, 45, { kind: 'filament', turn: 24 }),
      C([1479, 2300, 475, 325], '#a5f3fc', 0.003, 0.55, 47),
    ],
  },
  // Sgr A*: the disk's blue and rose, and the long jet the hole fires from its pole.
  disk: {
    haze: ['#2563eb', '#db2777', '#6d28d9'],
    clouds: [
      C([1479, 340, 525, 350], '#f472b6', 0.003, 0.7, 51),
      C([127, 900, 525, 375], '#3b82f6', 0.003, 0.7, 53),
      C([1501, 1550, 70, 620], '#93c5fd', 0.009, 0.95, 55, { kind: 'filament', turn: 8 }),
      C([1501, 1550, 200, 800], '#818cf8', 0.004, 0.45, 57, { turn: 8 }),
      C([132, 2200, 525, 375], '#ec4899', 0.0032, 0.65, 59),
    ],
  },
  // The star chart: the Milky Way crossing the sky, split by its dark rift.
  milkyway: {
    haze: ['#4f46e5', '#a16207', '#6d28d9'],
    clouds: [
      C([800, 1300, 1700, 230], '#c7d2fe', 0.004, 0.75, 61, { turn: 62 }),
      C([800, 1300, 1500, 110], '#fde68a', 0.0055, 0.5, 63, { turn: 62 }),
      C([800, 1300, 1500, 60], '#05040f', 0.007, 0.95, 65, { kind: 'dust', turn: 62 }),
      C([1490, 300, 350, 275], '#f9a8d4', 0.004, 0.45, 67),
    ],
  },
  // The pulsar: the torn shell of the supernova that made it.
  remnant: {
    haze: ['#b91c1c', '#0f766e', '#4338ca'],
    clouds: [
      C([1468, 600, 550, 525], '#f87171', 0.009, 0.9, 71, { kind: 'filament', shape: 'ring' }),
      C([1468, 600, 412, 400], '#2dd4bf', 0.0035, 0.55, 73),
      C([132, 1700, 375, 350], '#fb923c', 0.01, 0.85, 75, { kind: 'filament', shape: 'ring' }),
      C([1479, 2250, 500, 350], '#818cf8', 0.0035, 0.5, 77),
    ],
  },
  // The Local Group: thin light with far galaxies scattered through it.
  group: {
    haze: ['#6d28d9', '#1d4ed8', '#a21caf'],
    clouds: [
      C([143, 500, 575, 400], '#a78bfa', 0.003, 0.5, 81),
      C([1468, 1400, 575, 400], '#93c5fd', 0.003, 0.5, 83),
      C([143, 2200, 525, 375], '#f0abfc', 0.003, 0.45, 85),
    ],
    galaxies: 22,
  },
};

const { env } = Astro.props;
const { haze, clouds: features, sparkles = 0, galaxies = 0 } = ENVIRONMENTS[env];
// A soft haze down both sides, alternating left and right, so no stretch of the margins is empty.
const clouds = [
  ...Array.from({ length: 8 }, (_, index) =>
    C(
      [index % 2 ? 1500 : 100, 160 + index * 320, 470, 360],
      haze[index % haze.length],
      0.0026,
      0.62,
      features[0].seed * 7 + index,
    ),
  ),
  ...features,
];
const random = createRandom(env.length * 131 + clouds[0].seed);
const rgb = (hex: string) => [1, 3, 5].map((at) => Number.parseInt(hex.slice(at, at + 2), 16) / 255);

/** Colour matrix turning noise into tinted, thresholded alpha. Filaments keep only the brightest veins. */
const matrix = (cloud: Cloud) => {
  const [r, g, b] = rgb(cloud.color);
  const gain = cloud.kind === 'filament' ? 4.6 : 3.1;
  const cut = cloud.kind === 'filament' ? 1.95 : 1.0;
  const alpha = `${(gain * cloud.strength).toFixed(2)} 0 0 0 ${(-cut * cloud.strength).toFixed(2)}`;
  return `0 0 0 0 ${r.toFixed(3)} 0 0 0 0 ${g.toFixed(3)} 0 0 0 0 ${b.toFixed(3)} ${alpha}`;
};

// Stars as box-shadows of one dot per layer, spread over more than a screen height so the layers
// can glide upwards as the page scrolls (the far layer least, the near layer most).
const layer = (count: number, size: [number, number], alpha: [number, number], blur: number, depth: number) =>
  Array.from({ length: count }, () => {
    const a = random.between(alpha[0], alpha[1]).toFixed(2);
    const color = random.next() < 0.2 ? `rgb(255 222 190 / ${a})` : `rgb(225 232 255 / ${a})`;
    const at = `${random.between(0, 100).toFixed(2)}vw ${random.between(0, 100 + depth).toFixed(2)}vh`;
    return `${at} ${blur}px ${random.between(size[0], size[1]).toFixed(1)}px ${color}`;
  }).join(',');
const stars = [
  { depth: 25, shadow: layer(300, [0, 0.4], [0.25, 0.6], 0, 25) },
  { depth: 45, shadow: layer(110, [0.4, 0.9], [0.45, 0.85], 1, 45) },
  { depth: 70, shadow: layer(26, [0.8, 1.4], [0.75, 1], 3, 70) },
];

const sparkleStars = Array.from({ length: sparkles }, (_, index) => ({
  x: index % 2 ? random.between(1180, 1560) : random.between(40, 420),
  y: random.between(150, 2450),
  size: random.between(26, 60),
  delay: random.between(-8, 0).toFixed(1),
}));
const farGalaxies = Array.from({ length: galaxies }, () => ({
  x: random.next() < 0.5 ? random.between(30, 430) : random.between(1170, 1570),
  y: random.between(60, 2540),
  r: random.between(8, 24),
  tilt: random.between(0.25, 0.7),
  turn: random.between(0, 180),
}));
---

<div class="sky-backdrop" data-env={env} data-sky-backdrop aria-hidden="true">
  <svg class="sky-nebula" viewBox="0 0 1600 2600" preserveAspectRatio="xMidYMin slice">
    <defs>
      <radialGradient id="sky-shape-ellipse">
        <stop offset="0" stop-color="#fff"></stop>
        <stop offset="0.55" stop-color="#fff" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="sky-shape-ring">
        <stop offset="0.45" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.72" stop-color="#fff"></stop>
        <stop offset="0.86" stop-color="#fff" stop-opacity="0.5"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="sky-far-galaxy">
        <stop offset="0" stop-color="#fff7e8"></stop>
        <stop offset="0.3" stop-color="#c7d2fe" stop-opacity="0.6"></stop>
        <stop offset="1" stop-color="#c7d2fe" stop-opacity="0"></stop>
      </radialGradient>
      {
        clouds.map((cloud, index) => (
          <>
            <filter id={`sky-noise-${index}`} x="0" y="0" width="100%" height="100%">
              <feTurbulence
                type={cloud.kind === 'filament' ? 'turbulence' : 'fractalNoise'}
                baseFrequency={cloud.frequency}
                numOctaves="5"
                seed={cloud.seed}
              />
              <feColorMatrix type="matrix" values={matrix(cloud)} />
            </filter>
            <mask id={`sky-mask-${index}`}>
              <ellipse
                cx={cloud.x}
                cy={cloud.y}
                rx={cloud.rx}
                ry={cloud.ry}
                fill={`url(#sky-shape-${cloud.shape ?? 'ellipse'})`}
                transform={cloud.turn ? `rotate(${cloud.turn} ${cloud.x} ${cloud.y})` : undefined}
              />
            </mask>
          </>
        ))
      }
    </defs>
    {
      clouds.map((cloud, index) => {
        const reach = Math.max(cloud.rx, cloud.ry);
        return (
          <g class="sky-cloud" style={`--drift:${70 + index * 19}s;--delay:${index * -13}s`}>
            <rect
              x={cloud.x - reach}
              y={cloud.y - reach}
              width={reach * 2}
              height={reach * 2}
              filter={`url(#sky-noise-${index})`}
              mask={`url(#sky-mask-${index})`}
            />
          </g>
        );
      })
    }
    {
      farGalaxies.map((galaxy) => (
        <ellipse
          cx={galaxy.x.toFixed(0)}
          cy={galaxy.y.toFixed(0)}
          rx={galaxy.r.toFixed(1)}
          ry={(galaxy.r * galaxy.tilt).toFixed(1)}
          fill="url(#sky-far-galaxy)"
          transform={`rotate(${galaxy.turn.toFixed(0)} ${galaxy.x.toFixed(0)} ${galaxy.y.toFixed(0)})`}
        />
      ))
    }
    {
      sparkleStars.map((star) => (
        <g transform={`translate(${star.x.toFixed(0)} ${star.y.toFixed(0)})`}>
          <g class="sky-sparkle" style={`--delay:${star.delay}s`}>
            <circle r={(star.size * 0.32).toFixed(1)} fill="url(#sky-far-galaxy)" />
            <ellipse rx={star.size.toFixed(1)} ry="1.2" fill="#fff8e6" opacity="0.8" />
            <ellipse rx="1.2" ry={star.size.toFixed(1)} fill="#fff8e6" opacity="0.8" />
            <circle r="2.6" fill="#fff" />
          </g>
        </g>
      ))
    }
  </svg>
  {
    stars.map((layer, index) => (
      <span class={`sky-stars sky-stars-${index}`} style={`box-shadow:${layer.shadow};--depth:${layer.depth}vh`}></span>
    ))
  }
</div>

<script>
  // The surroundings travel with the reader: as the page scrolls, the nebula field and the star
  // layers glide upwards at their own depths (CSS reads --sky-progress, 0 at the top, 1 at the end).
  let frame = 0;
  function paint() {
    frame = 0;
    const backdrop = document.querySelector<HTMLElement>('[data-sky-backdrop]');
    if (!backdrop) return;
    const travel = document.documentElement.scrollHeight - window.innerHeight;
    backdrop.style.setProperty('--sky-progress', (travel > 0 ? Math.min(1, window.scrollY / travel) : 0).toFixed(4));
  }
  const onScroll = () => {
    if (!frame) frame = requestAnimationFrame(paint);
  };
  function init() {
    if (!document.querySelector('[data-sky-backdrop]')) return;
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
  if (document.readyState !== 'loading') init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    window.removeEventListener('scroll', onScroll);
    window.removeEventListener('resize', onScroll);
  });
</script>
