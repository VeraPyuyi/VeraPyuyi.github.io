---
/**
 * The homepage: four full-screen galaxies the visitor flies between with the scroll wheel.
 * The particles are drawn with WebGL (see ./galaxy-flight); every post is a clickable star
 * riding its galaxy's arms, ring or clumps.
 */
import { getCollection } from 'astro:content';
import { siteConfig, socialConfig } from '@constants/site-config';
import { Icon } from 'astro-icon/components';
import { localizedPath } from '@/i18n';
import { getBlogArticles } from '@/lib/blogs';
import { displayDate } from '@/lib/date';
import { type GalaxyItem, type GalaxyKind, placeGalaxyItems } from '@/lib/galaxy';
import { getPapers } from '@/lib/papers';
// Story styles first, so the phone overrides in galaxy-flight.css win.
import '@/styles/components/galaxy-flight-story.css';
import '@/styles/components/galaxy-flight.css';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const en = locale === 'en';

const blogs = await getBlogArticles(locale);
const papers = getPapers();
const albums = (await getCollection('albums')).filter((entry) => entry.data.language === 'zh' || entry.data.language === locale);
const moments = (await getCollection('moments')).filter(
  (entry) => !entry.data.draft && (entry.data.language === 'zh' || entry.data.language === locale),
);

/** First readable line of a moment, without Markdown links or emphasis. */
function momentTitle(body: string | undefined): string {
  const text = (body ?? '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .trim();
  const firstSentence = text.split(/(?<=[。！？.!?])/)[0] ?? text;
  return firstSentence.length > 40 ? `${firstSentence.slice(0, 40)}…` : firstSentence || (en ? 'A moment' : '一段日常');
}

const itemsByKind: Record<GalaxyKind, GalaxyItem[]> = {
  blogs: blogs.map((entry) => ({
    id: `blog-${entry.data.routeSlug}`,
    href: localizedPath(`/blogs/${entry.data.routeSlug}`, locale),
    title: entry.data.title,
    date: displayDate.date(entry.data.publishedAt),
    group: entry.data.category,
  })),
  papers: papers.map((paper) => ({
    id: `paper-${paper.id}`,
    href: localizedPath(`/papers/${paper.id}`, locale),
    title: en && paper.titleEn ? paper.titleEn : paper.title,
    date: paper.date,
  })),
  photos: albums.flatMap((album) =>
    album.data.photos.map((photo, index) => ({
      id: `photo-${album.id}-${index}`,
      href: localizedPath('/gallery', locale),
      title: `${album.data.name} · ${photo.alt}`,
      date: displayDate.date(photo.date ?? album.data.date ?? new Date()),
    })),
  ),
  moments: moments.map((entry) => ({
    id: `moment-${entry.id}`,
    href: localizedPath('/moments', locale),
    title: momentTitle(entry.body),
    date: displayDate.date(entry.data.date),
  })),
};

const kindLabel = (kind: GalaxyKind, group?: string): string => {
  if (kind === 'blogs') return group === 'learning' ? (en ? 'Learning' : '学习') : en ? 'Inspiration' : '灵感';
  if (kind === 'papers') return en ? 'Paper' : '论文';
  if (kind === 'photos') return en ? 'Photo' : '照片';
  return en ? 'Moment' : '生活';
};

const starColor = (kind: GalaxyKind, group?: string): string => {
  if (kind === 'blogs') return group === 'learning' ? '#b8e6fe' : '#fccee8';
  if (kind === 'papers') return '#ffd27a';
  if (kind === 'photos') return '#fef3c6';
  return '#b8e6fe';
};

/** Order matches GALAXY_PLACEMENTS in `@/lib/galaxy-flight`: the route visits them in this order. */
const galaxies: {
  kind: GalaxyKind;
  section: string;
  name: string;
  note: string;
  type: string;
  quote: string;
  href: string;
  accent: string;
}[] = [
  {
    kind: 'blogs',
    section: en ? 'Blogs' : '博客',
    name: en ? 'Whirlpool Galaxy' : '涡状星系',
    note: en
      ? 'Its arms keep winding back to the centre, the way every essay circles back to its first question.'
      : '旋臂一圈圈绕回中心，像每篇文字最后都绕回最初那个问题。',
    type: en ? 'M51 · grand-design spiral · with its companion NGC 5195' : 'M51 · 宏象旋涡星系 · 伴星系 NGC 5195',
    quote: en ? 'M51’s arms were drawn out by the companion galaxy beside it. Everything I write has a companion too: the question that made me start.' : 'M51 的旋臂，是被身旁的伴星系一路牵出来的。我写下的每篇文字旁边，也有一个伴星——那个让我动笔的问题。',
    href: localizedPath('/blogs', locale),
    accent: '#fccee8',
  },
  {
    kind: 'papers',
    section: en ? 'Papers' : '论文',
    name: 'NGC 1300',
    note: en
      ? 'A straight bar runs through the core and the arms unfurl from its ends: the rigorous skeleton comes first, then the argument can spread.'
      : '一根笔直的棒穿过核心，旋臂从棒端舒展开——先有严格的骨架，推论才能伸展。',
    type: en ? 'Barred spiral · Eridanus' : '棒旋星系 · 波江座',
    quote: en
      ? 'The straight bar is not solid: it is countless stars taking the same path, again and again. A proof is walked into being the same way.'
      : '那根笔直的棒并不是实心的，而是无数恒星一遍遍走过同一条路。证明也是这样走出来的。',
    href: localizedPath('/papers', locale),
    accent: '#ffd27a',
  },
  {
    kind: 'photos',
    section: en ? 'Photo wall' : '照片墙',
    name: en ? 'Hoag’s Object' : '霍格天体',
    note: en
      ? 'Almost nothing lies between its core and its ring, and no one is quite sure how the ring got there. Some pictures are allowed to be beautiful before they are explained. Look closely: another ring galaxy shines through the gap.'
      : '核心与光环之间几乎空无一物，至今没人能确定那道环是怎么来的。有些画面，可以先好看，再被解释。仔细看，缝隙里还透出另一个更遥远的环。',
    type: en ? 'Ring galaxy · Serpens' : '环状星系 · 巨蛇座',
    quote: en
      ? 'A photograph never records the moment itself, only the light that happened to arrive at that moment.'
      : '照片记下的从来不是那一刻，而是那一刻刚好抵达镜头的光。',
    href: localizedPath('/gallery', locale),
    accent: '#fef3c6',
  },
  {
    kind: 'moments',
    section: en ? 'Moments' : '生活动态',
    name: en ? 'Small Magellanic Cloud' : '小麦哲伦云',
    note: en
      ? 'It keeps no fixed shape, yet it never leaves the Milky Way’s side, much like ordinary days. 47 Tucanae glitters beside it.'
      : '没有固定的形状，却一直陪在银河身边，像日子。身旁那团密集的金光，是球状星团杜鹃座 47。',
    type: en ? 'SMC · dwarf irregular · Tucana' : '小麦哲伦云 · 不规则矮星系 · 杜鹃座',
    quote: en
      ? 'Circling the Milky Way, the Small Magellanic Cloud trails a long stream of gas behind it. Days shed small things too; I pick them up.'
      : '小麦哲伦云绕着银河走，身后拖着一条长长的气流。日子也会掉下些细碎的东西，我把它们捡起来。',
    href: localizedPath('/moments', locale),
    accent: '#b8e6fe',
  },
];

const placed = galaxies.map((galaxy) => {
  const stars = placeGalaxyItems(galaxy.kind, itemsByKind[galaxy.kind]);
  return { ...galaxy, stars, newest: stars.find((star) => star.newest) };
});

/** The last stop: the black hole at the heart of the Milky Way, holding the self-introduction. */
const hole = {
  index: placed.length,
  section: en ? 'About me' : '关于我',
  name: en ? 'Sagittarius A*' : '人马座 A*',
  type: en
    ? 'The supermassive black hole at the heart of the Milky Way · not even light leaves its horizon'
    : '银河系中心的超大质量黑洞 · 视界之内，连光也无法离开',
  quote: en
    ? 'I am in no hurry to answer my questions. An answer ends a question, and I would like to keep it company a little longer.'
    : '我不急着给问题找答案。答案一到，问题就走了，而我还想和它多待一会儿。',
  about: en
    ? [
        'Most of what I study does not have a name yet. By day I read papers, push symbols and write code; by night I write down what I understood, what I did not, and what I only thought I had. The last kind is the most common, and the most worth keeping.',
        'Here are papers, blog posts, photographs, and a few things I did not get round to saying. They are not sorted by importance, only by when they set out: every page tells you how long its light has been travelling.',
      ]
    : [
        '我研究的东西，多数时候还没有名字。白天读论文、推公式、写代码；晚上把弄懂的、没弄懂的、以为弄懂其实没有的，一并记下来——最后一种最多，也最值得记。',
        '这里放着论文、博客、照片，和几句没来得及说出口的话。它们不按重要性排列，只按出发的时间：每一页都标着，它的光已经走了多久。',
      ],
  note: en
    ? 'Every ray bends and turns back here, the way each sentence I write circles back to me in the end. My links orbit it; catch one.'
    : '所有的光都在这里弯折、回头，像我写下的每一句话，最后都绕回自己。我的联系方式在它周围绕行，伸手就能接住。',
  ask: en ? 'Click the black hole to read about me' : '轻点黑洞，读一读我',
  href: localizedPath('/about', locale),
  accent: '#ffcf8a',
};

/** Links that orbit the black hole: social profiles first, then a few doors inside the site. */
const orbitLinks = [
  ...Object.entries(socialConfig).map(([key, link]) => ({
    key,
    label: (link.label ?? key).replace(/\s*\(.*\)|\s*@\S+/g, ''),
    href: link.url,
    icon: link.icon,
    external: /^https?:/.test(link.url),
  })),
  {
    key: 'guestbook',
    label: en ? 'Guestbook' : '留言板',
    href: localizedPath('/guestbook', locale),
    icon: 'ri:chat-smile-2-line',
    external: false,
  },
  { key: 'friends', label: en ? 'Friends' : '友链', href: localizedPath('/friends', locale), icon: 'ri:links-line', external: false },
  { key: 'about', label: en ? 'About' : '关于', href: hole.href, icon: 'ri:user-heart-line', external: false },
];
/** `placeGalaxyItems` returns 0–100 % of the drawing square; the 3D models use units of the radius. */
const toUnit = (percent: number) => ((percent - 50) / 46).toFixed(4);
const starPath =
  'M12 1.5c.6 5.2 2.3 8.3 10.5 10.5C14.3 14.2 12.6 17.3 12 22.5 11.4 17.3 9.7 14.2 1.5 12 9.7 9.8 11.4 6.7 12 1.5z';
---

<section
  class="flight"
  aria-labelledby="flight-title"
  style={`--stops:${placed.length + 1}`}
  data-flight
  data-locale={locale}
  data-pagefind-ignore="all"
>
  <div class="flight-stage" data-flight-stage>
    <canvas class="flight-canvas" data-flight-canvas aria-hidden="true"></canvas>

    <div class="flight-intro" data-flight-fade="0.35">
      <p class="flight-moon" data-flight-moon>{en ? 'Tonight' : '今晚'}</p>
      <h1 id="flight-title" class="font-chill-round">{siteConfig.title}</h1>
      <p class="flight-greeting" data-flight-greeting>{siteConfig.subtitle}</p>
      <p class="flight-lead">
        {
          en
            ? 'Every star you see is light it sent long ago. These words are the same: the one who wrote them has already moved on.'
            : '你看见的每一颗星，都是它很久以前发出的光。这里的字也一样——写下它们的那个我，已经走远了。'
        }
      </p>
    </div>

    <div class="flight-stars">
      {
        placed.flatMap((galaxy, index) =>
          galaxy.stars.map((star, order) => (
            <a
              class="flight-star"
              href={star.href}
              style={`--star:${starColor(galaxy.kind, star.group)};--delay:${(order * 0.37) % 3}s`}
              data-flight-star
              data-star-id={star.id}
              data-galaxy={index}
              data-u={toUnit(star.x)}
              data-v={toUnit(star.y)}
              data-warp
              data-warp-color={starColor(galaxy.kind, star.group)}
              data-title={star.title}
              data-date={star.date}
              data-kind={kindLabel(galaxy.kind, star.group)}
              aria-label={
                en
                  ? `${kindLabel(galaxy.kind, star.group)}: ${star.title}, ${star.date}`
                  : `${kindLabel(galaxy.kind, star.group)}：${star.title}，${star.date}`
              }
            >
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d={starPath} />
              </svg>
            </a>
          )),
        )
      }
      {
        orbitLinks.map((link, order) => (
          <a
            class="flight-star flight-orbit"
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            style={`--star:${hole.accent};--delay:${(order * 0.41) % 3}s`}
            data-flight-star
            data-galaxy={hole.index}
            data-u="0"
            data-v="0"
            data-orbit={((order / orbitLinks.length) * Math.PI * 2).toFixed(4)}
            data-title={link.label}
            data-date={link.external ? new URL(link.href).hostname.replace(/^www\./, '') : en ? 'on this site' : '站内'}
            data-kind={en ? 'Link' : '链接'}
          >
            <Icon name={link.icon} aria-hidden="true" />
            <span class="flight-orbit-name">{link.label}</span>
          </a>
        ))
      }
    </div>

    {
      placed.map((galaxy, index) => (
        <article
          id={`flight-story-${index}`}
          class="flight-label"
          data-flight-label
          data-ask={en ? 'Click the galaxy to hear its story' : '轻点星系，听它说说自己'}
          style={`--accent:${galaxy.accent}`}
        >
          <p class="flight-kicker">
            <span class="flight-number">{String(index + 1).padStart(2, '0')}</span>
            {galaxy.section}
            <span class="flight-count">{en ? `${galaxy.stars.length} stars` : `${galaxy.stars.length} 颗星`}</span>
          </p>
          <h2>
            <a
              class="flight-name font-chill-round"
              href={galaxy.href}
              data-warp
              data-warp-color={galaxy.accent}
              data-flight-enter={index}
              aria-label={en ? `${galaxy.section}: ${galaxy.name}` : `${galaxy.section}：${galaxy.name}`}
            >
              {galaxy.name}
              <Icon name="ri:arrow-right-line" aria-hidden="true" />
            </a>
          </h2>
          <p class="flight-type">{galaxy.type}</p>
          <p class="flight-quote">{galaxy.quote}</p>
          <p class="flight-note">{galaxy.note}</p>
          <p class="flight-info" role="status">
            {galaxy.newest ? (
              <>
                <span class="flight-info-head" data-flight-info-head>
                  {en ? 'Newest' : '最新'} · {kindLabel(galaxy.kind, galaxy.newest.group)} · {galaxy.newest.date}
                </span>
                <span class="flight-info-title" data-flight-info-title>
                  {galaxy.newest.title}
                </span>
              </>
            ) : (
              <span class="flight-info-title">{en ? 'No stars here yet.' : '这里还没有星星。'}</span>
            )}
          </p>
        </article>
      ))
    }

    <article
      id={`flight-story-${hole.index}`}
      class="flight-label flight-about"
      data-flight-label
      data-ask={hole.ask}
      style={`--accent:${hole.accent}`}
    >
      <p class="flight-kicker">
        <span class="flight-number">{String(hole.index + 1).padStart(2, '0')}</span>
        {hole.section}
        <span class="flight-count">{en ? `${orbitLinks.length} links in orbit` : `${orbitLinks.length} 条航线在绕行`}</span>
      </p>
      <h2>
        <a
          class="flight-name font-chill-round"
          href={hole.href}
          data-warp
          data-warp-color={hole.accent}
          data-flight-enter={hole.index}
          aria-label={en ? `${hole.section}: ${hole.name}` : `${hole.section}：${hole.name}`}
        >
          {hole.name}
          <Icon name="ri:arrow-right-line" aria-hidden="true" />
        </a>
      </h2>
      <p class="flight-type">{hole.type}</p>
      <div class="flight-me">
        <img src={siteConfig.avatar ?? '/img/avatar.webp'} alt="" width="56" height="56" loading="lazy" decoding="async" />
        <div>
          <p class="flight-me-name">{siteConfig.name}</p>
          {hole.about.map((paragraph) => <p class="flight-me-text">{paragraph}</p>)}
        </div>
      </div>
      <p class="flight-quote">{hole.quote}</p>
      <p class="flight-note">{hole.note}</p>
    </article>

    <nav class="flight-nav" aria-label={en ? 'Four galaxies and a black hole' : '四个星系和一个黑洞'}>
      {
        placed.map((galaxy, index) => (
          <button
            type="button"
            data-flight-goto={index}
            aria-controls={`flight-story-${index}`}
            aria-expanded="false"
            style={`--accent:${galaxy.accent}`}
          >
            <span class="flight-nav-name">{galaxy.name}</span>
            <span class="flight-nav-dot" aria-hidden="true"></span>
          </button>
        ))
      }
      <button
        type="button"
        data-flight-goto={hole.index}
        aria-controls={`flight-story-${hole.index}`}
        aria-expanded="false"
        style={`--accent:${hole.accent}`}
      >
        <span class="flight-nav-name">{hole.name}</span>
        <span class="flight-nav-dot"></span>
      </button>
    </nav>

    <p class="flight-ask" data-flight-ask aria-hidden="true">
      <span class="flight-ask-dot"></span>
      <span data-flight-ask-text>{en ? 'Click the galaxy to hear its story' : '轻点星系，听它说说自己'}</span>
    </p>

    <p class="flight-hint" data-flight-fade="0.12" aria-hidden="true">
      <span class="flight-mouse"></span>
      {en ? 'Scroll to fly' : '滚动，穿过星系'}
    </p>
  </div>
</section>

<script>
  import { mountGalaxyFlight } from './galaxy-flight/controller';

  let unmount: (() => void) | null = null;
  let mounted: HTMLElement | null = null;

  function init() {
    const root = document.querySelector<HTMLElement>('[data-flight]');
    if (root === mounted) return;
    unmount?.();
    unmount = null;
    mounted = root;
    if (root) unmount = mountGalaxyFlight(root);
  }

  if (document.readyState !== 'loading') init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    unmount?.();
    unmount = null;
    mounted = null;
  });
</script>
