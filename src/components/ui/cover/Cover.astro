---
import { siteConfig } from '@constants/site-config';
import { Icon } from 'astro-icon/components';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { MAX_WIDTH } from '@/constants/layout';
import { getLocaleFromUrl, t } from '@/i18n';
import WaveSvg from './wave';

export interface CoverProps {
  title?: string;
  /** Utility pages can opt into a shorter cover with a neutral loading surface. */
  compact?: boolean;
  image?: string;
  imageAlt?: string;
  paperFontProfile?: 'latin-modern' | 'computer-modern';
}

const { title, compact = false, image = '/og.png', imageAlt, paperFontProfile } = Astro.props as CoverProps;

const resolvedImageAlt = imageAlt ?? 'Pyuyi 的小宇宙：粉蓝色星空书房与原创星星猫插画';

const locale = getLocaleFromUrl(Astro.url.pathname);

const copyLinkLabel = t(locale, 'cover.copyLink');
const copiedLabel = t(locale, 'common.copied');
const copyFailedLabel = t(locale, 'common.copyFailed');
---

<div
  class:list={[
    'relative z-0 flex overflow-hidden',
    compact ? 'h-[42dvh] min-h-72 max-h-120 tablet:h-[36dvh] tablet:min-h-64' : 'h-[60dvh] max-h-200',
  ]}
  data-paper-font={paperFontProfile}
>
  <div class="absolute inset-0 h-full bg-black/40"></div>
  {
    !title && (
      <div class="cover-sky pointer-events-none absolute inset-0" aria-hidden="true">
        <span class="cover-shooting-star"></span>
      </div>
    )
  }
  <div
    class:list={[
      'absolute inset-0 flex flex-col items-center justify-center px-5 text-white',
      compact ? 'bottom-[4dvh]' : 'bottom-[8dvh]',
    ]}
  >
    {
      title ? (
        <h1
          class:list={[
            'shadow-text word-break flex w-full items-center justify-center gap-2 text-center font-bold text-balance',
            MAX_WIDTH.content,
            paperFontProfile && 'paper-cover-heading',
            compact
              ? 'text-4xl/[1.15] tracking-[0.08em] tablet:text-3xl/[1.15] tablet:tracking-[0.05em]'
              : 'text-5xl/[1.2] tracking-widest',
          ]}
          data-paper-heading-fit={paperFontProfile ? 'cover' : undefined}
        >
          <span class:list={[paperFontProfile && 'paper-heading-text']} data-paper-heading-text={paperFontProfile ? '' : undefined}>
            {title}
          </span>
          <button
            type="button"
            class="cover-copy-link hover:text-primary inline-flex shrink-0 cursor-pointer items-center rounded-full p-1 transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            aria-label={copyLinkLabel}
            title={copyLinkLabel}
            data-copy-label={copyLinkLabel}
            data-copied-label={copiedLabel}
            data-copy-failed-label={copyFailedLabel}
          >
            <Icon name="ri:link" class={compact ? 'size-7 tablet:size-6' : undefined} aria-hidden="true" />
            <span class="sr-only" aria-live="polite"></span>
          </button>
        </h1>
      ) : (
        <>
          <p
            class="cover-greeting mb-5 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/15 px-4 py-1.5 text-sm backdrop-blur-sm"
            data-cover-greeting
            data-locale={locale}
            hidden
          >
            <Icon name="ri:moon-clear-fill" class="size-4 text-amber-200" aria-hidden="true" />
            <span data-cover-greeting-text></span>
          </p>
          <h2 class="shadow-text font-chill-round text-5xl/[1.2]">{siteConfig?.alternate}</h2>
          <h1 class="shadow-text font-chill-round mt-3 text-5xl/[1.2] font-bold tracking-widest">{siteConfig?.title}</h1>
          <p class="shadow-text mt-5 text-sm">= {siteConfig?.subtitle} =</p>
        </>
      )
    }
  </div>
  <div
    class:list={['relative -z-10 h-full min-h-60 w-full', compact && 'bg-card']}
    id="banner-box"
  >
    <ResponsiveImage
      src={image}
      alt={resolvedImageAlt}
      class="h-full w-full object-cover"
      pictureClass="h-full w-full"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <WaveSvg />
</div>

<script>
  function installCoverCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.cover-copy-link:not([data-copy-ready])').forEach((button) => {
      button.dataset.copyReady = 'true';
      button.addEventListener('click', async () => {
        const value = window.location.href;
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          window.prompt(button.dataset.copyFailedLabel ?? button.dataset.copyLabel ?? '', value);
          return;
        }

        const status = button.querySelector<HTMLElement>('[aria-live]');
        if (status) status.textContent = button.dataset.copiedLabel ?? '';
        button.title = button.dataset.copiedLabel ?? button.title;
        window.setTimeout(() => {
          if (status) status.textContent = '';
          button.title = button.dataset.copyLabel ?? button.title;
        }, 1800);
      });
    });
  }

  installCoverCopyButtons();
  document.addEventListener('astro:page-load', installCoverCopyButtons);
</script>

<script>
  import { dayPart } from '@/lib/galaxy';

  const GREETINGS = {
    zh: {
      morning: '早安，晨光照进小宇宙了',
      afternoon: '午后好，今天也在认真观测',
      evening: '晚上好，星星陆续亮起来了',
      night: '夜深了，星星都醒着',
    },
    en: {
      morning: 'Good morning, dawn is reaching the little universe',
      afternoon: 'Good afternoon, still observing carefully today',
      evening: 'Good evening, the stars are coming out',
      night: 'It’s late, and every star is awake',
    },
  } as const;

  function showCoverGreeting() {
    document.querySelectorAll<HTMLElement>('[data-cover-greeting]').forEach((element) => {
      const text = element.querySelector('[data-cover-greeting-text]');
      if (!text) return;
      const table = element.dataset.locale === 'en' ? GREETINGS.en : GREETINGS.zh;
      text.textContent = table[dayPart(new Date().getHours())];
      element.hidden = false;
    });
  }

  if (document.readyState !== 'loading') showCoverGreeting();
  document.addEventListener('astro:page-load', showCoverGreeting);
</script>

<style>
  .cover-sky {
    background-image:
      radial-gradient(1.5px 1.5px at 12% 22%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 22% 48%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 34% 16%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 8% 64%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 40% 38%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 28% 72%, #fff 50%, transparent 51%);
    animation: cover-twinkle 4.5s ease-in-out infinite alternate;
  }

  .cover-shooting-star {
    position: absolute;
    top: 14%;
    right: 10%;
    width: 9rem;
    height: 2px;
    border-radius: 9999px;
    background: linear-gradient(to right, transparent, #fff);
    filter: drop-shadow(0 0 6px rgb(255 255 255 / 0.9));
    opacity: 0;
    transform-origin: right center;
    animation: cover-shoot 9s linear 2s infinite;
  }

  @keyframes cover-twinkle {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 0.9;
    }
  }

  @keyframes cover-shoot {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(152deg);
    }
    2% {
      opacity: 1;
    }
    12%,
    100% {
      opacity: 0;
      transform: translate(-35rem, 19rem) rotate(152deg);
    }
  }

  :global(html.motion-off) .cover-sky,
  :global(html.motion-off) .cover-shooting-star {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-sky,
    .cover-shooting-star {
      animation: none;
    }
  }
</style>
