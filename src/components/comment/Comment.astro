---
/**
 * Comment Router Component
 *
 * Selects the appropriate comment provider based on site configuration.
 * Supports: remark42, giscus, waline, twikoo, none
 */
import { commentConfig } from '@/constants/site-config';
import { getLocaleFromUrl, t } from '@/i18n';
import { cn } from '@/lib/utils';
import { christmasEnabled } from '@/store/christmas';

interface Props {
  contentId?: string;
}

const { contentId } = Astro.props;

const provider = commentConfig.provider ?? 'none';
const locale = getLocaleFromUrl(Astro.url.pathname);
let Provider = null;
const providerReady =
  (provider !== 'giscus' ||
    Boolean(commentConfig.giscus?.repo && commentConfig.giscus?.repoId && commentConfig.giscus?.categoryId)) &&
  (provider !== 'waline' || Boolean(commentConfig.waline?.serverURL));

if (provider === 'remark42') {
  Provider = (await import('./providers/Remark42.astro')).default;
} else if (provider === 'giscus') {
  Provider = (await import('./providers/GiscusClient.astro')).default;
} else if (provider === 'waline') {
  Provider = (await import('./providers/WalineClient.astro')).default;
} else if (provider === 'twikoo') {
  Provider = (await import('./providers/TwikooClient.astro')).default;
}
---

{
  provider !== 'none' && Provider && (
    <div class={cn('comments w-full', { 'z-5': christmasEnabled.get() })}>
      <p class="text-muted-foreground mb-4 text-center text-sm">{t(locale, 'comment.prompt')}</p>
      {providerReady ? (
        <Provider contentId={contentId} />
      ) : (
        <div class="rounded-2xl border border-dashed border-pink-300 bg-pink-50/70 p-5 text-center text-sm text-pink-900 dark:border-pink-400/30 dark:bg-pink-500/10 dark:text-pink-100">
          {provider === 'waline'
            ? locale === 'en'
              ? 'The on-page rich-media comment UI is ready. Add the public Waline server URL to connect it.'
              : '站内图片与表情留言界面已经接好；填入 Waline 的公开服务地址后即可连接。'
            : locale === 'en'
              ? 'Comments are ready in the code. Add the public Giscus repository and category IDs to enable GitHub sign-in.'
              : '留言组件已经接好；填入 Giscus 的公开仓库 ID 与分类 ID 后，即可使用 GitHub 登录留言。'}
        </div>
      )}
    </div>
  )
}
