---
import { Icon } from 'astro-icon/components';
import { localizedPath } from '@/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const en = locale === 'en';
const features = [
  {
    href: '/papers',
    icon: 'ri:book-open-fill',
    title: en ? 'Papers' : '论文',
    text: en
      ? 'The proof reaches the end of the page; the one seeking answers still stands alone before the unknown.'
      : '证明抵达纸页尽头，求解的人仍独自站在未知之前。',
    tone: 'from-pink-200/70 to-violet-200/60 dark:from-pink-500/15 dark:to-violet-500/15',
  },
  {
    href: '/blogs',
    icon: 'ri:global-line',
    title: en ? 'Blogs' : '博客',
    text: en ? 'Lines of words light up one by one; only the night ever answers.' : '字句一行行亮起，回应它们的始终只有深夜。',
    tone: 'from-sky-200/70 to-cyan-100/70 dark:from-sky-500/15 dark:to-cyan-500/10',
  },
  {
    href: '/gallery',
    icon: 'ri:gallery-fill',
    title: en ? 'Photo Wall' : '照片墙',
    text: en
      ? 'Photographs keep the world’s light; beyond the frame, only a long silence remains.'
      : '照片替世界保存了光，镜头之外却只剩漫长的寂静。',
    tone: 'from-amber-100/80 to-rose-200/60 dark:from-amber-500/10 dark:to-rose-500/15',
  },
  {
    href: '/moments',
    icon: 'ri:chat-smile-3-fill',
    title: en ? 'Moments' : '生活动态',
    text: en
      ? 'Days pass slowly by; no one knows the thoughts that were never spoken.'
      : '日子从身旁缓慢经过，无人知晓那些未说出口的心事。',
    tone: 'from-indigo-100/80 to-blue-200/60 dark:from-indigo-500/10 dark:to-blue-500/15',
  },
];
---

<section aria-labelledby="explore-title" class="space-y-4">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-primary text-xs font-semibold tracking-[0.22em] uppercase">Explore</p>
      <h2 id="explore-title" class="font-chill-round mt-1 text-2xl font-bold">{en ? 'A small universe in progress' : '正在生长的小宇宙'}</h2>
    </div>
    <a class="text-primary text-sm hover:underline" href={localizedPath('/about', locale)}>{en ? 'About me →' : '关于我 →'}</a>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    {features.map((feature) => (
      <a
        href={localizedPath(feature.href, locale)}
        class={`group rounded-3xl border border-white/60 bg-gradient-to-br p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg motion-reduce:transform-none motion-reduce:transition-none dark:border-white/10 ${feature.tone}`}
      >
        <span class="bg-background/75 text-primary mb-5 inline-flex size-11 items-center justify-center rounded-2xl shadow-sm backdrop-blur">
          <Icon name={feature.icon} class="size-5" />
        </span>
        <h3 class="text-lg font-bold">{feature.title}</h3>
        <p class="text-muted-foreground mt-2 text-sm leading-6">{feature.text}</p>
      </a>
    ))}
  </div>
</section>
