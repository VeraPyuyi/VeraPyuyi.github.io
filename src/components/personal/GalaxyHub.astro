---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { localizedPath } from '@/i18n';
import { getBlogArticles } from '@/lib/blogs';
import { displayDate } from '@/lib/date';
import { type GalaxyItem, type GalaxyKind, placeGalaxyItems } from '@/lib/galaxy';
import { getPapers } from '@/lib/papers';
import '@/styles/components/galaxy-hub.css';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const en = locale === 'en';

const blogs = await getBlogArticles(locale);
const papers = getPapers();
const albums = (await getCollection('albums')).filter(
  (entry) => entry.data.language === 'zh' || entry.data.language === locale,
);
const moments = (await getCollection('moments')).filter(
  (entry) => !entry.data.draft && (entry.data.language === 'zh' || entry.data.language === locale),
);

/** First readable line of a moment, without Markdown links or emphasis. */
function momentTitle(body: string | undefined): string {
  const text = (body ?? '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .trim();
  const firstSentence = text.split(/(?<=[。！？.!?])/)[0] ?? text;
  return firstSentence.length > 40 ? `${firstSentence.slice(0, 40)}…` : firstSentence || (en ? 'A moment' : '一段日常');
}

const itemsByKind: Record<GalaxyKind, GalaxyItem[]> = {
  blogs: blogs.map((entry) => ({
    id: `blog-${entry.data.routeSlug}`,
    href: localizedPath(`/blogs/${entry.data.routeSlug}`, locale),
    title: entry.data.title,
    date: displayDate.date(entry.data.publishedAt),
    group: entry.data.category,
  })),
  papers: papers.map((paper) => ({
    id: `paper-${paper.id}`,
    href: localizedPath(`/papers/${paper.id}`, locale),
    title: en && paper.titleEn ? paper.titleEn : paper.title,
    date: paper.date,
  })),
  photos: albums.flatMap((album) =>
    album.data.photos.map((photo, index) => ({
      id: `photo-${album.id}-${index}`,
      href: localizedPath('/gallery', locale),
      title: `${album.data.name} · ${photo.alt}`,
      date: displayDate.date(photo.date ?? album.data.date ?? new Date()),
    })),
  ),
  moments: moments.map((entry) => ({
    id: `moment-${entry.id}`,
    href: localizedPath('/moments', locale),
    title: momentTitle(entry.body),
    date: displayDate.date(entry.data.date),
  })),
};

const kindLabel = (kind: GalaxyKind, group?: string): string => {
  if (kind === 'blogs') return group === 'learning' ? (en ? 'Learning' : '学习') : en ? 'Inspiration' : '灵感';
  if (kind === 'papers') return en ? 'Paper' : '论文';
  if (kind === 'photos') return en ? 'Photo' : '照片';
  return en ? 'Moment' : '生活';
};

const starColor = (kind: GalaxyKind, group?: string): string => {
  if (kind === 'blogs') return group === 'learning' ? '#b8e6fe' : '#fccee8';
  if (kind === 'papers') return '#ffd27a';
  if (kind === 'photos') return '#fef3c6';
  return '#b8e6fe';
};

const galaxies: {
  kind: GalaxyKind;
  /** The section this galaxy stands for. */
  section: string;
  /** A real galaxy whose shape this one borrows. */
  name: string;
  /** Why the name fits, shown on hover. */
  note: string;
  type: string;
  quote: string;
  href: string;
  accent: string;
  canvas: number;
  tilt: number;
  seconds: number;
  star: number;
}[] = [
  {
    kind: 'blogs',
    section: en ? 'Blogs' : '博客',
    name: en ? 'Whirlpool Galaxy' : '涡状星系',
    note: en
      ? 'Its arms keep winding back to the centre, the way every essay circles back to its first question.'
      : '旋臂一圈圈绕回中心，像每篇文字最后都绕回最初那个问题。',
    type: en ? 'M51 · grand-design spiral · inspiration arm, learning arm' : 'M51 · grand-design spiral · 灵感臂 / 学习臂',
    quote: en
      ? 'Lines of words light up one by one; only the night ever answers.'
      : '字句一行行亮起，回应它们的始终只有深夜。',
    href: localizedPath('/blogs', locale),
    accent: '#fccee8',
    canvas: 1000,
    tilt: 50,
    seconds: 150,
    star: 17,
  },
  {
    kind: 'papers',
    section: en ? 'Papers' : '论文',
    name: 'NGC 1300',
    note: en
      ? 'A straight bar runs through the core and the arms unfurl from its ends: the rigorous skeleton comes first, then the argument can spread.'
      : '一根笔直的棒穿过核心，旋臂从棒端舒展开——先有严格的骨架，推论才能伸展。',
    type: 'barred spiral · Eridanus',
    quote: en
      ? 'The proof reaches the end of the page; the one seeking answers still stands alone before the unknown.'
      : '证明抵达纸页尽头，求解的人仍独自站在未知之前。',
    href: localizedPath('/papers', locale),
    accent: '#ffd27a',
    canvas: 640,
    tilt: 60,
    seconds: 190,
    star: 22,
  },
  {
    kind: 'photos',
    section: en ? 'Photo wall' : '照片墙',
    name: en ? 'Hoag’s Object' : '霍格天体',
    note: en
      ? 'Almost nothing lies between its core and its ring, like the long silence just beyond a photograph.'
      : '核心与光环之间几乎空无一物，像照片之外那段漫长的寂静。',
    type: 'ring galaxy · Serpens',
    quote: en
      ? 'Photographs keep the world’s light; beyond the frame, only a long silence remains.'
      : '照片替世界保存了光，镜头之外却只剩漫长的寂静。',
    href: localizedPath('/gallery', locale),
    accent: '#fef3c6',
    canvas: 640,
    tilt: 40,
    seconds: 120,
    star: 20,
  },
  {
    kind: 'moments',
    section: en ? 'Moments' : '生活动态',
    name: en ? 'Small Magellanic Cloud' : '小麦哲伦云',
    note: en
      ? 'It keeps no fixed shape, yet it never leaves the Milky Way’s side, much like ordinary days.'
      : '没有固定的形状，却一直陪在银河身边，像日子。',
    type: 'SMC · dwarf irregular · Tucana',
    quote: en
      ? 'Days pass slowly by; no one knows the thoughts that were never spoken.'
      : '日子从身旁缓慢经过，无人知晓那些未说出口的心事。',
    href: localizedPath('/moments', locale),
    accent: '#b8e6fe',
    canvas: 640,
    tilt: 28,
    seconds: 240,
    star: 19,
  },
];

const placed = galaxies.map((galaxy) => {
  const stars = placeGalaxyItems(galaxy.kind, itemsByKind[galaxy.kind]);
  const newest = stars.find((star) => star.newest);
  return { ...galaxy, stars, newest };
});
const total = placed.reduce((sum, galaxy) => sum + galaxy.stars.length, 0);
const starPath =
  'M12 1.5c.6 5.2 2.3 8.3 10.5 10.5C14.3 14.2 12.6 17.3 12 22.5 11.4 17.3 9.7 14.2 1.5 12 9.7 9.8 11.4 6.7 12 1.5z';
---

<section
  class="galaxy-hub"
  aria-labelledby="galaxy-title"
  data-galaxy-hub
  data-locale={locale}
  data-pagefind-ignore="all"
>
  <div class="galaxy-sky" aria-hidden="true"></div>
  <div class="galaxy-head">
    <div>
      <p class="galaxy-eyebrow"><span class="galaxy-index">01</span>FOUR GALAXIES</p>
      <h2 id="galaxy-title" class="font-chill-round">{en ? 'Four galaxies in a small universe' : '小宇宙里的四个星系'}</h2>
      <p class="galaxy-lead">
        {
          en
            ? `Four galaxies, each turning at its own pace. Each of the ${total} stars was once a night spent on a question. Rest your cursor on one and it will pause for you.`
            : `四个星系，各自按自己的速度旋转；${total} 颗星，每一颗都曾是一个和问题待在一起的夜晚。停在星系上，它会为你停一停。`
        }
      </p>
    </div>
    <div class="galaxy-actions">
      <span class="galaxy-moon" data-galaxy-moon title={en ? 'Tonight’s real moon phase' : '今晚的真实月相'}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20">
          <defs><clipPath id="galaxy-moon-clip"><circle cx="10" cy="10" r="8"></circle></clipPath></defs>
          <circle cx="10" cy="10" r="8" fill="#3a4170"></circle>
          <g clip-path="url(#galaxy-moon-clip)">
            <circle cx="10" cy="10" r="8" fill="#fff1c4"></circle>
            <circle data-galaxy-moon-shadow cx="10" cy="10" r="8.6" fill="#3a4170"></circle>
          </g>
        </svg>
        <span data-galaxy-moon-label>{en ? 'Tonight' : '今晚'}</span>
      </span>
      <button type="button" class="galaxy-wish" data-galaxy-wish>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path d={starPath} fill="#ffd27a"></path></svg>
        {en ? 'Let the star cat pick one for me' : '让星星猫替我摘一颗'}
      </button>
    </div>
  </div>

  <div class="galaxy-grid">
    {
      placed.map((galaxy) => (
        <article
          class="galaxy-cell"
          data-galaxy-cell={galaxy.kind}
          style={`grid-area:${galaxy.kind};--accent:${galaxy.accent}`}
        >
          <div class="galaxy-stage">
            <div
              class="galaxy-disk"
              style={`--tilt:${galaxy.tilt}deg`}
              data-galaxy-disk={galaxy.kind}
              data-seconds={galaxy.seconds}
            >
              <canvas
                data-galaxy-canvas={galaxy.kind}
                width={galaxy.canvas}
                height={galaxy.canvas}
                aria-hidden="true"
              />
              <canvas
                data-galaxy-live={galaxy.kind}
                width={galaxy.canvas}
                height={galaxy.canvas}
                aria-hidden="true"
              />
              {galaxy.stars.map((star) => (
                <a
                  class:list={['galaxy-star', star.newest && 'is-newest']}
                  href={star.href}
                  style={`left:${star.x}%;top:${star.y}%`}
                  data-galaxy-star
                  data-warp
                  data-warp-color={starColor(galaxy.kind, star.group)}
                  data-title={star.title}
                  data-date={star.date}
                  data-kind={kindLabel(galaxy.kind, star.group)}
                  aria-label={
                    en
                      ? `${kindLabel(galaxy.kind, star.group)}: ${star.title}, ${star.date}`
                      : `${kindLabel(galaxy.kind, star.group)}：${star.title}，${star.date}`
                  }
                >
                  <svg aria-hidden="true" width={galaxy.star} height={galaxy.star} viewBox="0 0 24 24">
                    <path d={starPath} fill={starColor(galaxy.kind, star.group)} />
                  </svg>
                </a>
              ))}
            </div>
          </div>
          <div class="galaxy-text">
            <div>
              <h3>
                <span class="galaxy-section">{galaxy.section}</span>
                <a
                  class="galaxy-enter"
                  href={galaxy.href}
                  data-warp
                  data-warp-color={galaxy.accent}
                  title={galaxy.note}
                  aria-label={en ? `${galaxy.section}: ${galaxy.name}` : `${galaxy.section}：${galaxy.name}`}
                >
                  {galaxy.name}
                  <Icon name="ri:arrow-right-line" aria-hidden="true" />
                </a>
                <span class="galaxy-count">{en ? `${galaxy.stars.length} stars` : `${galaxy.stars.length} 颗星`}</span>
              </h3>
              <p class="galaxy-type">{galaxy.type}</p>
              <p class="galaxy-quote">{galaxy.quote}</p>
              <p class="galaxy-note">{galaxy.note}</p>
            </div>
            <div class="galaxy-info" role="status" data-galaxy-info>
              {galaxy.newest ? (
                <>
                  <p class="galaxy-info-head" data-galaxy-info-head>
                    {en ? 'Newest' : '最新'} · {kindLabel(galaxy.kind, galaxy.newest.group)} · {galaxy.newest.date}
                  </p>
                  <p class="galaxy-info-title" data-galaxy-info-title>
                    {galaxy.newest.title}
                  </p>
                </>
              ) : (
                <p class="galaxy-info-title">{en ? 'No stars here yet.' : '这里还没有星星。'}</p>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { type GalaxyKind, MOON_PHASE_NAMES, MOON_PHASE_NAMES_EN, moonPhase } from '@/lib/galaxy';
  import { createFieldStars, drawFieldStars, paintGalaxy } from '@/lib/galaxy-paint';

  const KINDS = new Set<GalaxyKind>(['blogs', 'papers', 'photos', 'moments']);
  /** Seconds for the speed to settle after the pointer enters or leaves. */
  const EASE_SECONDS = 0.45;
  /** Hovering a galaxy slows it to a drift; hovering a star stops it. */
  const HOVER_SPEED = 0.12;

  interface Spinner {
    kind: GalaxyKind;
    cell: HTMLElement;
    disk: HTMLElement;
    live: HTMLCanvasElement | null;
    stars: ReturnType<typeof createFieldStars>;
    /** Pattern speed, radians per second. */
    omega: number;
    angle: number;
    time: number;
    speed: number;
    cellHover: boolean;
    starHover: boolean;
  }

  let teardown: (() => void) | undefined;

  const prefersStill = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    document.documentElement.classList.contains('motion-off');

  function setInfo(cell: Element, head: string, title: string) {
    const headEl = cell.querySelector('[data-galaxy-info-head]');
    const titleEl = cell.querySelector('[data-galaxy-info-title]');
    if (headEl) headEl.textContent = head;
    if (titleEl) titleEl.textContent = title;
  }

  function initGalaxyHub() {
    const hub = document.querySelector<HTMLElement>('[data-galaxy-hub]:not([data-galaxy-ready])');
    if (!hub) return;
    hub.dataset.galaxyReady = 'true';
    const en = hub.dataset.locale === 'en';

    hub.querySelectorAll<HTMLCanvasElement>('canvas[data-galaxy-canvas]').forEach((canvas) => {
      const kind = canvas.dataset.galaxyCanvas as GalaxyKind;
      if (!KINDS.has(kind)) return;
      try {
        paintGalaxy(canvas, kind);
      } catch {
        canvas.hidden = true;
      }
    });

    const { phase, index, illumination } = moonPhase(Date.now());
    const shadow = hub.querySelector('[data-galaxy-moon-shadow]');
    shadow?.setAttribute('cx', (phase < 0.5 ? 10 - 32 * phase : 10 + 32 * (1 - phase)).toFixed(2));
    const moonLabel = hub.querySelector('[data-galaxy-moon-label]');
    if (moonLabel) {
      moonLabel.textContent = en ? `Tonight · ${MOON_PHASE_NAMES_EN[index]}` : `今晚 · ${MOON_PHASE_NAMES[index]}`;
    }
    const lit = Math.round(illumination * 100);
    hub.querySelector('[data-galaxy-moon]')?.setAttribute('title', en ? `Real moon phase · ${lit}% lit` : `真实月相 · 照亮 ${lit}%`);

    // ---- Rotation: one pattern speed per galaxy, eased on hover ----
    const spinners: Spinner[] = [...hub.querySelectorAll<HTMLElement>('[data-galaxy-disk]')].flatMap((disk) => {
      const kind = disk.dataset.galaxyDisk as GalaxyKind;
      const cell = disk.closest<HTMLElement>('[data-galaxy-cell]');
      if (!KINDS.has(kind) || !cell) return [];
      const seconds = Number(disk.dataset.seconds) || 180;
      const spinner: Spinner = {
        kind,
        cell,
        disk,
        live: disk.querySelector<HTMLCanvasElement>('canvas[data-galaxy-live]'),
        stars: createFieldStars(kind, kind === 'blogs' ? 420 : 200),
        omega: (Math.PI * 2) / seconds,
        angle: Math.random() * Math.PI * 2,
        time: 0,
        speed: prefersStill() ? 0 : 1,
        cellHover: false,
        starHover: false,
      };
      cell.addEventListener('pointerenter', () => (spinner.cellHover = true));
      cell.addEventListener('pointerleave', () => (spinner.cellHover = false));
      cell.addEventListener('focusin', () => (spinner.starHover = true));
      cell.addEventListener('focusout', () => (spinner.starHover = false));
      disk.querySelectorAll('[data-galaxy-star]').forEach((star) => {
        star.addEventListener('pointerenter', () => (spinner.starHover = true));
        star.addEventListener('pointerleave', () => (spinner.starHover = false));
      });
      return [spinner];
    });

    const render = (spinner: Spinner, twinkle: number) => {
      spinner.disk.style.setProperty('--rot', `${spinner.angle.toFixed(4)}rad`);
      if (spinner.live) drawFieldStars(spinner.live, spinner.stars, spinner.time, twinkle, spinner.omega);
    };
    spinners.forEach((spinner) => render(spinner, 0));

    let raf = 0;
    let last = 0;
    let visible = false;
    const frame = (now: number) => {
      const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
      last = now;
      const still = prefersStill();
      for (const spinner of spinners) {
        const target = still || spinner.starHover ? 0 : spinner.cellHover ? HOVER_SPEED : 1;
        spinner.speed += (target - spinner.speed) * (1 - Math.exp(-dt / EASE_SECONDS));
        spinner.angle += spinner.omega * spinner.speed * dt;
        spinner.time += spinner.speed * dt;
        render(spinner, still ? 0 : now / 1000);
      }
      raf = visible ? requestAnimationFrame(frame) : 0;
    };
    const observer = new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      if (visible && !raf) {
        last = 0;
        raf = requestAnimationFrame(frame);
      }
    });
    observer.observe(hub);

    // ---- Stars: hover details, the star cat's pick, and the warp jump ----
    const stars = [...hub.querySelectorAll<HTMLAnchorElement>('[data-galaxy-star]')];
    const focusStar = (star: HTMLAnchorElement, picked = false) => {
      const cell = star.closest('[data-galaxy-cell]');
      if (!cell) return;
      cell.querySelectorAll('.galaxy-star.is-on').forEach((other) => other.classList.remove('is-on'));
      star.classList.add('is-on');
      const prefix = picked ? (en ? 'Picked by the star cat' : '星星猫替你摘的') : en ? 'Looking at' : '注视中';
      setInfo(cell, `${prefix} · ${star.dataset.kind} · ${star.dataset.date}`, star.dataset.title ?? '');
    };
    for (const star of stars) {
      star.addEventListener('pointerenter', () => focusStar(star));
      star.addEventListener('focus', () => focusStar(star));
    }

    hub.querySelector('[data-galaxy-wish]')?.addEventListener('click', () => {
      if (stars.length === 0) return;
      const previous = hub.querySelector('.galaxy-star.is-picked');
      const pool = stars.filter((star) => star !== previous);
      const pick = pool[Math.floor(Math.random() * pool.length)] ?? stars[0];
      previous?.classList.remove('is-picked');
      hub.querySelectorAll('.galaxy-cell.is-wished').forEach((cell) => cell.classList.remove('is-wished'));
      // Restart the flash animation even when the same star class is re-added.
      pick.getBoundingClientRect();
      pick.classList.add('is-picked');
      pick.closest('.galaxy-cell')?.classList.add('is-wished');
      focusStar(pick, true);
    });

    hub.addEventListener('click', (event) => {
      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-warp]');
      const warpReady = (window as Window & { __pyuyiWarp?: boolean }).__pyuyiWarp;
      if (!link || !warpReady || prefersStill()) return;
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }
      event.preventDefault();
      const anchor = link.hasAttribute('data-galaxy-star')
        ? link
        : (link.closest('[data-galaxy-cell]')?.querySelector('[data-galaxy-disk]') ?? link);
      const rect = anchor.getBoundingClientRect();
      window.dispatchEvent(
        new CustomEvent('pyuyi:warp', {
          detail: { href: link.href, x: rect.left + rect.width / 2, y: rect.top + rect.height / 2, color: link.dataset.warpColor },
        }),
      );
    });

    teardown = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      visible = false;
      observer.disconnect();
    };
  }

  if (document.readyState !== 'loading') initGalaxyHub();
  document.addEventListener('astro:page-load', initGalaxyHub);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = undefined;
  });
</script>
