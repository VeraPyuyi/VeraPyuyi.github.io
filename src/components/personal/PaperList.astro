---
import { Icon } from 'astro-icon/components';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { defaultLocale, localizedPath } from '@/i18n';
import { getPapers } from '@/lib/papers';

interface Props {
  locale?: string;
  limit?: number;
  indexable?: boolean;
  randomized?: boolean;
}

const { locale = defaultLocale, limit, indexable = true, randomized = false } = Astro.props;
const en = locale === 'en';
const allPapers = getPapers();
const papers = randomized || limit === undefined ? allPapers : allPapers.slice(0, limit);
const visibleLimit = limit ?? papers.length;
const issueNumbers = new Map(
  [...allPapers]
    .sort((a, b) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id))
    .map((paper, index) => [paper.id, `No. ${String(index + 1).padStart(2, '0')}`]),
);
const pagefindAttributes = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': 'all' };
---

<div
  class="space-y-5"
  data-home-random-pool={randomized ? 'papers' : undefined}
  data-home-random-limit={randomized ? visibleLimit : undefined}
  {...pagefindAttributes}
>
  {
    papers.map((paper, index) => (
      <article
        class="group flex min-w-0 flex-col"
        data-home-random-item={randomized ? '' : undefined}
        hidden={randomized && index >= visibleLimit}
      >
        <a
          class="relative block aspect-video overflow-hidden rounded-3xl bg-gradient-to-br from-pink-200/75 via-violet-100/70 to-sky-200/75 shadow-sm transition-shadow duration-500 group-hover:shadow-xl"
          href={localizedPath(`/papers/${paper.id}`, locale)}
          aria-label={en && paper.titleEn ? paper.titleEn : paper.title}
        >
          <ResponsiveImage
            src={paper.cover ?? '/og.png'}
            alt={(en ? paper.coverAltEn : paper.coverAlt) ?? (en ? 'Pyuyi paper cover' : 'Pyuyi 论文封面')}
            class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025] motion-reduce:transform-none"
            pictureClass="h-full w-full"
            sizes="(min-width: 1024px) 60rem, 100vw"
            loading="lazy"
          />
          <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-white/5"></span>
        </a>
        <div class="space-y-4 px-1 pt-5 pb-2">
          <div class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
            <span class="paper-issue">{issueNumbers.get(paper.id)}</span>
            <time datetime={paper.date}>{paper.date}</time>
            <span>{paper.authors.join(', ')}</span>
          </div>
          <div>
            <h2 class="text-xl font-bold">
              <a class="hover:text-primary" href={localizedPath(`/papers/${paper.id}`, locale)}>
                {en && paper.titleEn ? paper.titleEn : paper.title}
              </a>
            </h2>
            <p class="text-muted-foreground mt-2 text-sm leading-6">
              {en && paper.abstractEn ? paper.abstractEn : paper.abstract}
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            {paper.keywords.map((keyword) => <span class="bg-primary/10 text-primary rounded-full px-2.5 py-1 text-xs">{keyword}</span>)}
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a
              class="text-primary inline-flex items-center gap-1 text-sm font-semibold hover:underline"
              href={localizedPath(`/papers/${paper.id}`, locale)}
            >
              <Icon name="ri:book-read-line" />
              {en ? 'Read HTML and download PDF' : '阅读 HTML 并下载 PDF'}
            </a>
            <a
              class="text-muted-foreground inline-flex items-center gap-1 text-sm hover:text-primary"
              href={paper.arxivUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="ri:external-link-line" />
              arXiv {paper.arxivVersion}
            </a>
          </div>
        </div>
      </article>
    ))
  }
</div>

<style>
  .paper-issue {
    font-family: 'Paper Latin Modern', 'Latin Modern Roman', Georgia, serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: linear-gradient(100deg, #9a6b1f 0%, #d6a53f 30%, #fff1c4 45%, #d6a53f 60%, #9a6b1f 100%);
    background-size: 220% 100%;
    background-clip: text;
    color: transparent;
    animation: paper-issue-shimmer 6s ease-in-out infinite;
  }

  @keyframes paper-issue-shimmer {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0 0;
    }
  }

  :global(html.motion-off) .paper-issue {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .paper-issue {
      animation: none;
    }
  }
</style>
