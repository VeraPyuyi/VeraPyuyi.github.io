---
import { Icon } from 'astro-icon/components';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { defaultLocale, localizedPath } from '@/i18n';
import { getPapers } from '@/lib/papers';

interface Props {
  locale?: string;
  limit?: number;
  indexable?: boolean;
  randomized?: boolean;
}

const { locale = defaultLocale, limit, indexable = true, randomized = false } = Astro.props;
const en = locale === 'en';
const allPapers = getPapers();
const papers = randomized || limit === undefined ? allPapers : allPapers.slice(0, limit);
const visibleLimit = limit ?? papers.length;
const pagefindAttributes = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': 'all' };
---

<div
  class="space-y-5"
  data-home-random-pool={randomized ? 'papers' : undefined}
  data-home-random-limit={randomized ? visibleLimit : undefined}
  {...pagefindAttributes}
>
  {
    papers.map((paper, index) => (
      <article
        class="grid grid-cols-[15rem_1fr] overflow-hidden rounded-3xl border border-black/5 bg-white/55 shadow-sm backdrop-blur md:grid-cols-1 dark:border-white/10 dark:bg-white/5"
        data-home-random-item={randomized ? '' : undefined}
        hidden={randomized && index >= visibleLimit}
      >
        <ResponsiveImage
          src={paper.cover ?? '/og.png'}
          alt={(en ? paper.coverAltEn : paper.coverAlt) ?? (en ? 'Pyuyi paper cover' : 'Pyuyi 论文封面')}
          class="h-full min-h-48 w-full object-cover"
          pictureClass="h-full min-h-48 w-full"
          sizes="(max-width: 768px) 100vw, 15rem"
          loading="lazy"
        />
        <div class="space-y-4 p-6">
          <div class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
            <time datetime={paper.date}>{paper.date}</time>
            <span>{paper.authors.join(', ')}</span>
          </div>
          <div>
            <h2 class="text-xl font-bold">
              <a class="hover:text-primary" href={localizedPath(`/papers/${paper.id}`, locale)}>
                {en && paper.titleEn ? paper.titleEn : paper.title}
              </a>
            </h2>
            <p class="text-muted-foreground mt-2 text-sm leading-6">
              {en && paper.abstractEn ? paper.abstractEn : paper.abstract}
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            {paper.keywords.map((keyword) => <span class="bg-primary/10 text-primary rounded-full px-2.5 py-1 text-xs">{keyword}</span>)}
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a
              class="text-primary inline-flex items-center gap-1 text-sm font-semibold hover:underline"
              href={localizedPath(`/papers/${paper.id}`, locale)}
            >
              <Icon name="ri:book-read-line" />
              {en ? 'Read HTML and download PDF' : '阅读 HTML 并下载 PDF'}
            </a>
            <a
              class="text-muted-foreground inline-flex items-center gap-1 text-sm hover:text-primary"
              href={paper.arxivUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="ri:external-link-line" />
              arXiv {paper.arxivVersion}
            </a>
          </div>
        </div>
      </article>
    ))
  }
</div>
