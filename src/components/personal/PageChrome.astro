---
/**
 * Frame for the blog's own pages (lists, posts, papers, gallery, moments, guestbook): the shared
 * night-to-dawn SkyPage. Articles get a compact hero with their cover pinned in the sky and a
 * table-of-contents rail; the `art` and `meta` slots pass through to the hero.
 */
import { HomeSiderType } from '@constants/enum';
import { siteConfig } from '@constants/site-config';
import SkyPage from '@/components/sky/SkyPage.astro';
import type { SkyEnvironment, SkyObject } from '@/lib/sky-catalog';

interface Props {
  locale: string;
  title: string;
  description: string;
  showDescription?: boolean;
  paperFontProfile?: 'latin-modern' | 'computer-modern';
  cover?: string;
  coverAlt?: string;
  siderType?: HomeSiderType;
  keywords?: string[];
  contentType?: 'website' | 'article';
  mathStyles?: boolean;
  /** The object on the homepage star map this page belongs to: its caption and hero art. */
  sky?: SkyObject;
  /** Caption for pages that are not a stop on the flight. */
  plate?: string;
  /** Sky for pages that are not a stop on the flight. */
  env?: SkyEnvironment;
}

const {
  locale,
  title,
  description,
  showDescription = true,
  paperFontProfile,
  cover,
  coverAlt,
  siderType,
  keywords,
  contentType = 'website',
  mathStyles = false,
  sky,
  plate,
  env,
} = Astro.props;
const article = contentType === 'article' || Boolean(cover);
---

<SkyPage
  locale={locale}
  title={`${title} | ${siteConfig.title}`}
  heading={title}
  description={description}
  showDescription={showDescription}
  object={sky}
  env={env}
  plate={plate}
  image={cover}
  imageAlt={coverAlt}
  compact={article}
  toc={siderType === HomeSiderType.POST}
  paperFontProfile={paperFontProfile}
  siderType={siderType}
  keywords={keywords}
  contentType={contentType}
>
  {mathStyles && <link slot="head" rel="stylesheet" href="/katex/katex.min.css" />}
  {Astro.slots.has('art') && <slot name="art" slot="art" />}
  {Astro.slots.has('meta') && <slot name="meta" slot="meta" />}
  <slot />
</SkyPage>
