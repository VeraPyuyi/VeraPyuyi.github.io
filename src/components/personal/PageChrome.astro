---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';

interface Props {
  locale: string;
  title: string;
  description: string;
  showDescription?: boolean;
  paperFontProfile?: 'latin-modern' | 'computer-modern';
  cover?: string;
  coverAlt?: string;
}

const { locale, title, description, showDescription = true, paperFontProfile, cover, coverAlt } = Astro.props;
---

<Layout locale={locale} title={`${title} | ${siteConfig.title}`} description={description}>
  <TwoColumnLayout>
    <Cover
      slot="cover"
      title={title}
      compact
      image={cover}
      imageAlt={coverAlt}
      paperFontProfile={paperFontProfile}
    />
    <HomeSider slot="sider" />
    <div
      class={`shadow-box bg-gradient-start flex min-w-0 w-full max-w-full flex-col gap-8 overflow-x-clip ${CONTENT_PADDING.standard}`}
      data-paper-font={paperFontProfile}
    >
      <header class="space-y-3 border-b border-black/5 pb-6 dark:border-white/10">
        <p class="text-primary text-xs font-semibold tracking-[0.24em] uppercase">Pyuyi's log</p>
        <h1
          class:list={['font-chill-round text-3xl font-bold tracking-wide', paperFontProfile && 'paper-page-heading']}
          data-paper-heading-fit={paperFontProfile ? 'page' : undefined}
        >
          {title}
        </h1>
        {showDescription && <p class="text-muted-foreground max-w-3xl leading-7">{description}</p>}
      </header>
      <slot />
    </div>
  </TwoColumnLayout>
</Layout>
