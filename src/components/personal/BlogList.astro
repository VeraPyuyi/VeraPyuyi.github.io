---
import { Icon } from 'astro-icon/components';
import readingTime from 'reading-time';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { defaultLocale, localizedPath } from '@/i18n';
import { getBlogArticles } from '@/lib/blogs';
import { displayDate } from '@/lib/date';

interface Props {
  locale?: string;
  limit?: number;
  indexable?: boolean;
  randomized?: boolean;
}

const { locale = defaultLocale, limit, indexable = true, randomized = false } = Astro.props;
const en = locale === 'en';
const allBlogs = await getBlogArticles(locale);
const blogs = randomized || limit === undefined ? allBlogs : allBlogs.slice(0, limit);
const visibleLimit = limit ?? blogs.length;
const pagefindAttributes = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': 'all' };
---

<div
  class="grid gap-5 lg:grid-cols-2"
  data-home-random-pool={randomized ? 'blogs' : undefined}
  data-home-random-limit={randomized ? visibleLimit : undefined}
  {...pagefindAttributes}
>
  {
    blogs.map((entry, index) => {
      const href = localizedPath(`/blogs/${entry.data.routeSlug}`, locale);
      const minutes = Math.max(1, Math.ceil(readingTime(entry.body ?? '').minutes));
      return (
        <article
          class="group flex min-w-0 flex-col overflow-hidden rounded-3xl border border-black/5 bg-white/55 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:shadow-xl motion-reduce:transform-none dark:border-white/10 dark:bg-white/5"
          data-home-random-item={randomized ? '' : undefined}
          hidden={randomized && index >= visibleLimit}
        >
          <a
            class="relative block aspect-video overflow-hidden bg-gradient-to-br from-pink-200/75 via-violet-100/70 to-sky-200/75"
            href={href}
            aria-label={entry.data.title}
          >
            <ResponsiveImage
              src={entry.data.cover ?? '/og.png'}
              alt={entry.data.coverAlt ?? (en ? `${entry.data.title} cover` : `${entry.data.title}封面`)}
              class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025] motion-reduce:transform-none"
              pictureClass="h-full w-full"
              sizes="(min-width: 1024px) 36rem, 100vw"
              loading="lazy"
            />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-white/5"></span>
          </a>
          <div class="flex flex-1 flex-col gap-4 p-6">
            <div class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
              <time datetime={entry.data.publishedAt.toISOString()}>{displayDate.date(entry.data.publishedAt)}</time>
              <span aria-hidden="true">·</span>
              <span>{en ? `${minutes} min read` : `约 ${minutes} 分钟`}</span>
            </div>
            <div class="space-y-2">
              <h2 class="text-xl leading-8 font-bold text-pretty">
                <a class="hover:text-primary" href={href}>{entry.data.title}</a>
              </h2>
              <p class="text-muted-foreground text-sm leading-6">{entry.data.summary}</p>
            </div>
            <a class="text-primary mt-auto inline-flex items-center gap-1 text-sm font-semibold hover:underline" href={href}>
              <Icon name="ri:book-read-line" />
              {en ? 'Read the essay' : '阅读全文'}
            </a>
          </div>
        </article>
      );
    })
  }
</div>
