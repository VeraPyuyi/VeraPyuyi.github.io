---
import { Icon } from 'astro-icon/components';
import readingTime from 'reading-time';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { defaultLocale, localizedPath } from '@/i18n';
import { type BlogCategory, getBlogArticles, getBlogCategoryLabel } from '@/lib/blogs';
import { displayDate } from '@/lib/date';

interface Props {
  locale?: string;
  limit?: number;
  indexable?: boolean;
  category?: BlogCategory;
}

const { locale = defaultLocale, limit, indexable = true, category } = Astro.props;
const en = locale === 'en';
const allBlogs = await getBlogArticles(locale, category);
const blogs = limit === undefined ? allBlogs : allBlogs.slice(0, limit);
const pagefindAttributes = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': 'all' };
---

{
  blogs.length === 0 ? (
    <div
      class="rounded-3xl border border-dashed border-black/10 bg-white/35 px-6 py-10 text-center dark:border-white/15 dark:bg-white/[0.03]"
      {...pagefindAttributes}
    >
      <p class="text-muted-foreground text-sm leading-7">
        {en
          ? 'The Learning shelf is still taking shape. Its first essay will appear here when it is ready.'
          : 'Learning 分类还在慢慢整理，第一篇文章写好后会出现在这里。'}
      </p>
    </div>
  ) : (
    <div class="grid gap-5 lg:grid-cols-2" {...pagefindAttributes}>
  {
    blogs.map((entry) => {
      const href = localizedPath(`/blogs/${entry.data.routeSlug}`, locale);
      const categoryHref = `${localizedPath('/blogs', locale)}#${entry.data.category}`;
      const minutes = Math.max(1, Math.ceil(readingTime(entry.body ?? '').minutes));
      return (
        <article class="group relative flex min-w-0 flex-col">
          <a
            class="relative block aspect-video overflow-hidden rounded-3xl bg-gradient-to-br from-pink-200/75 via-violet-100/70 to-sky-200/75 shadow-sm group-hover:shadow-xl"
            href={href}
            aria-label={entry.data.title}
            data-tilt-card
          >
            <ResponsiveImage
              src={entry.data.cover ?? '/og.png'}
              alt={entry.data.coverAlt ?? (en ? `${entry.data.title} cover` : `${entry.data.title}封面`)}
              class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025] motion-reduce:transform-none"
              pictureClass="h-full w-full"
              sizes="(min-width: 1024px) 36rem, 100vw"
              loading="lazy"
            />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-white/5"></span>
            <span class="card-sheen" aria-hidden="true"></span>
          </a>
          <div class="flex flex-1 flex-col gap-3 px-1 pt-5 pb-2">
            <div class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
              <a
                class="text-primary rounded-[3px] border border-primary/40 px-2 py-0.5 font-medium tracking-wide hover:bg-primary/8"
                href={categoryHref}
              >
                {getBlogCategoryLabel(entry.data.category)}
              </a>
              <time datetime={entry.data.publishedAt.toISOString()}>{displayDate.date(entry.data.publishedAt)}</time>
              <span aria-hidden="true">·</span>
              <span>{en ? `${minutes} min read` : `约 ${minutes} 分钟`}</span>
            </div>
            <div class="space-y-2">
              <h2 class="text-xl leading-8 font-bold text-pretty">
                <a class="hover:text-primary" href={href}>{entry.data.title}</a>
              </h2>
              <p class="text-muted-foreground text-sm leading-6">{entry.data.summary}</p>
            </div>
            <a class="text-primary mt-auto inline-flex items-center gap-1 text-sm font-semibold hover:underline" href={href}>
              <Icon name="ri:book-read-line" />
              {en ? 'Read the essay' : '阅读全文'}
            </a>
          </div>
        </article>
      );
    })
  }
    </div>
  )
}

<script>
  const MAX_TILT = { x: 6, y: 8 };

  function motionAllowed(): boolean {
    return (
      window.matchMedia('(pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
      !document.documentElement.classList.contains('motion-off')
    );
  }

  function initTiltCards() {
    document.querySelectorAll<HTMLElement>('[data-tilt-card]:not([data-tilt-ready])').forEach((card) => {
      card.dataset.tiltReady = 'true';
      card.addEventListener('pointermove', (event) => {
        if (!motionAllowed()) return;
        const rect = card.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width;
        const py = (event.clientY - rect.top) / rect.height;
        const rotateX = ((0.5 - py) * MAX_TILT.x).toFixed(2);
        const rotateY = ((px - 0.5) * MAX_TILT.y).toFixed(2);
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        card.style.setProperty('--sheen-x', `${(px * 100).toFixed(1)}%`);
        card.style.setProperty('--sheen-y', `${(py * 100).toFixed(1)}%`);
        card.style.setProperty('--sheen-angle', `${(110 + (px - 0.5) * 30).toFixed(0)}deg`);
        card.classList.add('is-tilting');
      });
      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
        card.classList.remove('is-tilting');
      });
    });
  }

  if (document.readyState !== 'loading') initTiltCards();
  document.addEventListener('astro:page-load', initTiltCards);
</script>

<style>
  [data-tilt-card] {
    transition-property: translate, transform, box-shadow;
    transition-duration: 0.25s;
  }

  .card-sheen {
    pointer-events: none;
    position: absolute;
    inset: 0;
    opacity: 0;
    mix-blend-mode: soft-light;
    background:
      radial-gradient(circle at var(--sheen-x, 50%) var(--sheen-y, 50%), rgb(255 255 255 / 0.75), transparent 45%),
      linear-gradient(
        var(--sheen-angle, 110deg),
        transparent 30%,
        rgb(252 206 232 / 0.55) 45%,
        rgb(184 230 254 / 0.55) 55%,
        transparent 70%
      );
    transition: opacity 0.3s;
  }

  .is-tilting .card-sheen {
    opacity: 1;
  }
</style>
