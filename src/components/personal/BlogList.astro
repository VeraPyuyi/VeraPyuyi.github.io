---
import { getCollection, render } from 'astro:content';
import CustomContent from '@components/common/CustomContent.astro';
import { Icon } from 'astro-icon/components';
import ResponsiveImage from '@/components/personal/ResponsiveImage.astro';
import { defaultLocale, localizedPath } from '@/i18n';

interface Props {
  locale?: string;
  limit?: number;
  indexable?: boolean;
}

const { locale = defaultLocale, limit, indexable = true } = Astro.props;
const en = locale === 'en';
const allBlogs = (await getCollection('blogs'))
  .filter((entry) => entry.data.language === 'zh' || entry.data.language === locale)
  .sort((a, b) => b.data.order - a.data.order);
const blogs = limit === undefined ? allBlogs : allBlogs.slice(0, limit);
const rendered = await Promise.all(blogs.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const pagefindAttributes = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': 'all' };
const statusText = {
  idea: en ? 'Idea' : '构思中',
  active: en ? 'Active' : '更新中',
  maintained: en ? 'Maintained' : '维护中',
  archived: en ? 'Archived' : '已归档',
};
---

<div class="grid gap-5 lg:grid-cols-2" {...pagefindAttributes}>
  {
    rendered.map(({ entry, Content }) => {
      const anchor = `blog-${entry.id.replace(/[^a-z0-9_-]+/gi, '-')}`;
      return (
        <article
          id={anchor}
          class="group scroll-mt-24 overflow-hidden rounded-3xl border border-black/5 bg-white/55 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:shadow-xl motion-reduce:transform-none dark:border-white/10 dark:bg-white/5"
        >
          {entry.data.cover && (
            <ResponsiveImage
              src={entry.data.cover}
              alt={`${entry.data.name} ${en ? 'cover' : '封面'}`}
              class="aspect-[16/8] w-full object-cover"
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
          )}
          <div class="space-y-4 p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="text-xl font-bold">{entry.data.name}</h2>
                <p class="text-muted-foreground mt-1 text-sm leading-6">{entry.data.description}</p>
              </div>
              <span class="bg-primary/10 text-primary shrink-0 rounded-full px-3 py-1 text-xs font-semibold">
                {statusText[entry.data.status]}
              </span>
            </div>
            <div class="flex flex-wrap gap-2">
              {entry.data.tags.map((tag) => <span class="rounded-full bg-black/5 px-2.5 py-1 text-xs dark:bg-white/10">{tag}</span>)}
            </div>
            <div class="prose prose-sm dark:prose-invert"><CustomContent Content={Content} /></div>
            <div class="flex flex-wrap gap-3 text-sm font-semibold">
              {entry.data.source && (
                <a
                  class="text-primary inline-flex items-center gap-1 hover:underline"
                  href={entry.data.source}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="ri:github-fill" />
                  {en ? 'Source' : '源码'}
                </a>
              )}
              {entry.data.url && (
                <a
                  class="text-primary inline-flex items-center gap-1 hover:underline"
                  href={entry.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="ri:external-link-line" />
                  {en ? 'Visit' : '访问'}
                </a>
              )}
              <a
                class="text-muted-foreground inline-flex items-center gap-1 hover:text-primary"
                href={`${localizedPath('/blogs', locale)}#${anchor}`}
              >
                <Icon name="ri:link" />
                {en ? 'Permalink' : '固定链接'}
              </a>
            </div>
          </div>
        </article>
      );
    })
  }
</div>
