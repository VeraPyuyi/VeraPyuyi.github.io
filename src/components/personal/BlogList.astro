---
import { Icon } from 'astro-icon/components';
import readingTime from 'reading-time';
import { defaultLocale, localizedPath } from '@/i18n';
import { getBlogArticles } from '@/lib/blogs';
import { displayDate } from '@/lib/date';

interface Props {
  locale?: string;
  limit?: number;
  indexable?: boolean;
}

const { locale = defaultLocale, limit, indexable = true } = Astro.props;
const en = locale === 'en';
const allBlogs = await getBlogArticles(locale);
const blogs = limit === undefined ? allBlogs : allBlogs.slice(0, limit);
const pagefindAttributes = indexable ? { 'data-pagefind-body': '' } : { 'data-pagefind-ignore': 'all' };
---

<div class="grid gap-5 lg:grid-cols-2" {...pagefindAttributes}>
  {
    blogs.map((entry) => {
      const href = localizedPath(`/blogs/${entry.data.routeSlug}`, locale);
      const minutes = Math.max(1, Math.ceil(readingTime(entry.body ?? '').minutes));
      return (
        <article class="group flex min-w-0 flex-col overflow-hidden rounded-3xl border border-black/5 bg-white/55 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:shadow-xl motion-reduce:transform-none dark:border-white/10 dark:bg-white/5">
          <a
            class="relative flex aspect-[16/7] items-center justify-center overflow-hidden bg-gradient-to-br from-pink-200/75 via-violet-100/70 to-sky-200/75 dark:from-pink-500/15 dark:via-violet-500/10 dark:to-sky-500/15"
            href={href}
            aria-label={entry.data.title}
          >
            <span class="absolute -top-8 -right-5 size-28 rounded-full bg-white/45 blur-2xl dark:bg-white/5"></span>
            <span class="bg-primary/15 absolute -bottom-10 -left-4 size-32 rounded-full blur-2xl"></span>
            <Icon name="ri:quill-pen-line" class="text-primary relative size-11 drop-shadow-sm transition group-hover:rotate-[-6deg] motion-reduce:transform-none" />
          </a>
          <div class="flex flex-1 flex-col gap-4 p-6">
            <div class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
              <time datetime={entry.data.publishedAt.toISOString()}>{displayDate.date(entry.data.publishedAt)}</time>
              <span aria-hidden="true">·</span>
              <span>{en ? `${minutes} min read` : `约 ${minutes} 分钟`}</span>
            </div>
            <div class="space-y-2">
              <h2 class="text-xl leading-8 font-bold text-pretty">
                <a class="hover:text-primary" href={href}>{entry.data.title}</a>
              </h2>
              <p class="text-muted-foreground text-sm leading-6">{entry.data.summary}</p>
            </div>
            <a class="text-primary mt-auto inline-flex items-center gap-1 text-sm font-semibold hover:underline" href={href}>
              <Icon name="ri:book-read-line" />
              {en ? 'Read the essay' : '阅读全文'}
            </a>
          </div>
        </article>
      );
    })
  }
</div>
