---
/**
 * Full-screen "warp drive" played when a galaxy star is clicked.
 *
 * 1. Aim   — the camera turns to the chosen star and slowly pushes in on it
 *            (the page itself zooms toward the star while the edges darken).
 * 2. Spool — nearby stars begin to stretch into trails as the drive charges,
 *            motes of light spiral into the star and a lens flare opens across it;
 *            the next page is fetched.
 * 3. Jump  — a flash, full streaks; the streaks keep running until the new page
 *            has arrived and a minimum cruise has passed.
 * 4. Arrive — the streaks decelerate and the darkness lifts off the new page.
 *
 * The canvas persists across client-side navigations, so this is one continuous shot.
 * Start it with: window.dispatchEvent(new CustomEvent('pyuyi:warp', { detail }))
 * where detail = { href, x, y, color? } in viewport pixels.
 */
---

<canvas id="pyuyi-warp" class="pyuyi-warp" aria-hidden="true" transition:persist="pyuyi-warp"></canvas>

<script>
  import { navigate } from 'astro:transitions/client';

  interface WarpDetail {
    href: string;
    x: number;
    y: number;
    color?: string;
  }

  interface Streak {
    angle: number;
    dist: number;
    depth: number;
    width: number;
    color: string;
  }

  interface Mote {
    angle: number;
    radius: number;
    spin: number;
    size: number;
    color: string;
    delay: number;
  }

  type Phase = 'idle' | 'aim' | 'spool' | 'cruise' | 'arrive';

  const AIM_MS = 1100;
  const SPOOL_MS = 900;
  /** Start fetching the next page part-way through the spool-up… */
  const PREFETCH_AT_MS = AIM_MS + 200;
  /** …and hand over to it at the moment of the jump. */
  const NAVIGATE_AT_MS = AIM_MS + SPOOL_MS;
  const MIN_CRUISE_MS = 700;
  const MAX_CRUISE_MS = 5000;
  const ARRIVE_MS = 850;
  /** Push-in on the chosen star during the aim. */
  const ZOOM = 2.6;
  /** If the client router has not delivered the page by now, load it the plain way. */
  const HARD_NAVIGATION_MS = 3500;
  /** Whatever happens to animation frames, the overlay never outlives this. */
  const WATCHDOG_MS = AIM_MS + SPOOL_MS + MAX_CRUISE_MS + ARRIVE_MS + 800;
  const PALETTE = ['#ffffff', '#ffffff', '#dbe9ff', '#b8e6fe', '#fccee8', '#ffd27a'];

  const warpWindow = window as Window & { __pyuyiWarp?: boolean };
  warpWindow.__pyuyiWarp = true;

  let phase: Phase = 'idle';
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let streaks: Streak[] = [];
  let motes: Mote[] = [];
  let origin = { x: 0, y: 0 };
  let accent = '#ffd27a';
  let phaseAt = 0;
  let startedAt = 0;
  let lastFrame = 0;
  let arrived = false;
  let raf = 0;
  let watchdog = 0;
  let hardNavigation = 0;
  let zoomed: HTMLElement | null = null;

  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
  const easeInCubic = (t: number) => t * t * t;
  const easeOutCubic = (t: number) => 1 - (1 - t) ** 3;
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

  function withAlpha(hex: string, alpha: number): string {
    const value = hex.replace('#', '');
    const full = value.length === 3 ? [...value].map((digit) => digit + digit).join('') : value.slice(0, 6);
    const number = Number.parseInt(full, 16);
    if (Number.isNaN(number)) return `rgba(255, 210, 122, ${alpha})`;
    return `rgba(${(number >> 16) & 255}, ${(number >> 8) & 255}, ${number & 255}, ${alpha})`;
  }

  function createMotes(count: number): Mote[] {
    return Array.from({ length: count }, () => ({
      angle: Math.random() * Math.PI * 2,
      radius: 70 + Math.random() ** 0.6 * 260,
      spin: (2.2 + Math.random() * 2.4) * (Math.random() < 0.85 ? 1 : -1),
      size: 0.8 + Math.random() * 1.8,
      color: Math.random() < 0.45 ? accent : PALETTE[Math.floor(Math.random() * PALETTE.length)],
      delay: Math.random() * 0.35,
    }));
  }

  function resize() {
    if (!canvas) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(window.innerWidth * dpr);
    canvas.height = Math.round(window.innerHeight * dpr);
    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function spawn(reach: number, anywhere: boolean): Streak {
    return {
      angle: Math.random() * Math.PI * 2,
      dist: anywhere ? (0.04 + Math.random() ** 0.7) * reach : Math.random() * reach * 0.06,
      depth: 0.35 + Math.random() * 0.65,
      width: 0.6 + Math.random() * 1.5,
      color: Math.random() < 0.2 ? accent : PALETTE[Math.floor(Math.random() * PALETTE.length)],
    };
  }

  /** Camera push: move the chosen star to the centre of the screen and zoom in on it. */
  function aimCamera(detail: WarpDetail) {
    const main = document.querySelector<HTMLElement>('main');
    if (!main) return;
    const rect = main.getBoundingClientRect();
    zoomed = main;
    main.style.transformOrigin = `${detail.x - rect.left}px ${detail.y - rect.top}px`;
    main.style.transition = `transform ${AIM_MS + SPOOL_MS}ms cubic-bezier(0.65, 0, 0.35, 1), filter ${AIM_MS + SPOOL_MS}ms ease-in`;
    main.style.willChange = 'transform';
    // Let the starting state paint, then animate to the target.
    main.getBoundingClientRect();
    main.style.transform = `translate(${window.innerWidth / 2 - detail.x}px, ${window.innerHeight / 2 - detail.y}px) scale(${ZOOM})`;
    main.style.filter = 'blur(1.5px)';
  }

  function releaseCamera() {
    if (!zoomed) return;
    zoomed.style.transform = '';
    zoomed.style.transition = '';
    zoomed.style.transformOrigin = '';
    zoomed.style.filter = '';
    zoomed.style.willChange = '';
    zoomed = null;
  }

  function finish() {
    phase = 'idle';
    cancelAnimationFrame(raf);
    window.clearTimeout(watchdog);
    window.clearTimeout(hardNavigation);
    releaseCamera();
    if (canvas) canvas.style.opacity = '0';
    ctx?.clearRect(0, 0, window.innerWidth, window.innerHeight);
    streaks = [];
    motes = [];
  }

  function enter(next: Phase, now: number) {
    phase = next;
    phaseAt = now;
  }

  function frame(now: number) {
    if (!ctx || !canvas || phase === 'idle') return;
    const dt = Math.min(0.05, Math.max(0, now - lastFrame) / 1000);
    lastFrame = now;
    const width = window.innerWidth;
    const height = window.innerHeight;
    const reach = Math.hypot(width, height) / 2;
    const inPhase = Math.max(0, now - phaseAt);
    const sinceStart = Math.max(0, now - startedAt);

    // Velocity of the drive (0 = still, 1 = full warp), darkness of the backdrop,
    // and how tightly the darkness hugs the edges (vignette) versus covers everything.
    let velocity = 1;
    let darkness = 0.95;
    let vignette = 0;

    if (phase === 'aim') {
      const p = clamp01(inPhase / AIM_MS);
      velocity = 0.04 * p;
      darkness = 0.75 * easeInOut(p);
      vignette = 1;
      if (p >= 1) enter('spool', now);
    } else if (phase === 'spool') {
      const p = clamp01(inPhase / SPOOL_MS);
      velocity = 0.04 + 0.96 * easeInCubic(p);
      darkness = 0.75 + 0.2 * p;
      vignette = 1 - easeInOut(p);
      if (p >= 1) enter('cruise', now);
    } else if (phase === 'cruise') {
      if ((arrived && inPhase > MIN_CRUISE_MS) || inPhase > MAX_CRUISE_MS) enter('arrive', now);
    } else if (phase === 'arrive') {
      const p = clamp01(inPhase / ARRIVE_MS);
      velocity = 1 - easeOutCubic(p);
      darkness = 0.95 * (1 - p) ** 1.5;
      if (p >= 1) {
        finish();
        return;
      }
    }

    // The camera turns to the star over the aim + spool, in step with the page zoom
    // (easeInOut below is the same curve as the CSS cubic-bezier(0.65, 0, 0.35, 1)).
    const turn = easeInOut(clamp01(sinceStart / (AIM_MS + SPOOL_MS)));
    const center =
      phase === 'cruise' || phase === 'arrive'
        ? { x: width / 2, y: height / 2 }
        : { x: origin.x + (width / 2 - origin.x) * turn, y: origin.y + (height / 2 - origin.y) * turn };

    ctx.clearRect(0, 0, width, height);
    const backdrop = ctx.createRadialGradient(center.x, center.y, 0, center.x, center.y, reach);
    const inner = darkness * (1 - vignette * 0.85);
    backdrop.addColorStop(0, `rgba(46, 52, 104, ${inner})`);
    backdrop.addColorStop(vignette > 0 ? 0.35 : 0.01, `rgba(30, 34, 74, ${darkness * (1 - vignette * 0.4)})`);
    backdrop.addColorStop(1, `rgba(10, 12, 30, ${darkness})`);
    ctx.fillStyle = backdrop;
    ctx.fillRect(0, 0, width, height);

    // Stars around the target: dots at rest, stretching into trails as the drive spools up.
    ctx.lineCap = 'round';
    const fadeIn = clamp01(sinceStart / 500);
    for (let i = 0; i < streaks.length; i++) {
      const streak = streaks[i];
      const before = streak.dist;
      const pace = velocity * (reach * 1.2 + streak.dist * 2.8) * streak.depth;
      streak.dist += (pace + reach * 0.015) * dt;
      if (streak.dist > reach * 1.1) {
        if (phase === 'arrive') continue;
        streaks[i] = spawn(reach, phase === 'aim');
        continue;
      }
      const trail = velocity * streak.dist * (0.06 + 0.5 * velocity) + 0.6;
      const tail = Math.max(phase === 'aim' ? streak.dist - 0.6 : before, streak.dist - trail);
      const near = clamp01(streak.dist / (reach * 0.2));
      ctx.strokeStyle = streak.color;
      ctx.globalAlpha = fadeIn * near * (0.4 + 0.6 * streak.depth) * (phase === 'arrive' ? 0.3 + 0.7 * velocity : 1);
      ctx.lineWidth = streak.width * streak.depth * (0.7 + (streak.dist / reach) * 1.3);
      ctx.beginPath();
      ctx.moveTo(center.x + Math.cos(streak.angle) * tail, center.y + Math.sin(streak.angle) * tail);
      ctx.lineTo(center.x + Math.cos(streak.angle) * streak.dist, center.y + Math.sin(streak.angle) * streak.dist);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    // The chosen star: a soft corona that swells as the camera closes in and breathes while charging.
    if (phase === 'aim' || phase === 'spool') {
      const swell = phase === 'aim' ? easeInOut(clamp01(inPhase / AIM_MS)) : 1;
      const charge = phase === 'spool' ? clamp01(inPhase / SPOOL_MS) : 0;
      const breathe = phase === 'spool' ? 1 + Math.sin(inPhase / 90) * 0.06 * (1 - charge) : 1;
      const radius = (14 + swell * 30 + charge * 26) * breathe;
      const corona = ctx.createRadialGradient(center.x, center.y, 0, center.x, center.y, radius * 4);
      corona.addColorStop(0, 'rgba(255, 255, 255, 1)');
      corona.addColorStop(0.08, 'rgba(255, 252, 244, 0.95)');
      corona.addColorStop(0.2, withAlpha(accent, 0.55));
      corona.addColorStop(0.45, withAlpha(accent, 0.14));
      corona.addColorStop(1, withAlpha(accent, 0));
      ctx.globalCompositeOperation = 'lighter';
      ctx.globalAlpha = 0.3 + 0.7 * swell;
      ctx.fillStyle = corona;
      ctx.fillRect(center.x - radius * 4, center.y - radius * 4, radius * 8, radius * 8);

      // Anamorphic lens flare: a thin horizontal light that opens across the star.
      const flareWidth = (0.18 + 0.5 * swell + 0.55 * charge) * width;
      const flare = ctx.createLinearGradient(center.x - flareWidth / 2, 0, center.x + flareWidth / 2, 0);
      flare.addColorStop(0, withAlpha(accent, 0));
      flare.addColorStop(0.42, withAlpha('#dbe9ff', 0.35));
      flare.addColorStop(0.5, 'rgba(255, 255, 255, 0.9)');
      flare.addColorStop(0.58, withAlpha('#dbe9ff', 0.35));
      flare.addColorStop(1, withAlpha(accent, 0));
      ctx.globalAlpha = (0.25 + 0.75 * swell) * (0.55 + 0.45 * charge);
      ctx.fillStyle = flare;
      const thickness = 1.2 + charge * 2.2;
      ctx.fillRect(center.x - flareWidth / 2, center.y - thickness / 2, flareWidth, thickness);
      ctx.globalAlpha *= 0.35;
      ctx.fillRect(center.x - flareWidth / 2, center.y - thickness * 3, flareWidth, thickness * 6);
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    // Charging: motes of light spiral in and fall into the star, leaving short curved trails.
    if (phase === 'spool' || (phase === 'aim' && inPhase > AIM_MS * 0.6)) {
      const p = phase === 'spool' ? clamp01(inPhase / SPOOL_MS) : 0;
      const warmup = phase === 'aim' ? clamp01((inPhase - AIM_MS * 0.6) / (AIM_MS * 0.4)) : 1;
      ctx.globalCompositeOperation = 'lighter';
      ctx.lineCap = 'round';
      for (const mote of motes) {
        const local = clamp01((p - mote.delay) / (1 - mote.delay));
        const fall = local ** 1.6;
        const r = mote.radius * (1 - fall);
        if (r < 3) continue;
        const angle = mote.angle + mote.spin * (local + local * local);
        const sweep = 0.05 + 0.25 * local;
        const x = center.x + Math.cos(angle) * r;
        const y = center.y + Math.sin(angle) * r * 0.62;
        const tx = center.x + Math.cos(angle - sweep * Math.sign(mote.spin)) * r * 1.04;
        const ty = center.y + Math.sin(angle - sweep * Math.sign(mote.spin)) * r * 0.62 * 1.04;
        ctx.globalAlpha = warmup * (0.25 + 0.75 * local) * Math.min(1, r / 40);
        ctx.strokeStyle = mote.color;
        ctx.lineWidth = mote.size;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.quadraticCurveTo((tx + x) / 2 + (y - ty) * 0.15, (ty + y) / 2 - (x - tx) * 0.15, x, y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    // Flash on the jump, and a softer one as we drop out of warp.
    const flash = phase === 'cruise' ? inPhase / 320 : phase === 'arrive' ? inPhase / 280 : -1;
    if (flash >= 0 && flash < 1) {
      ctx.fillStyle = `rgba(255, 246, 232, ${(1 - flash) * (phase === 'cruise' ? 0.55 : 0.18)})`;
      ctx.fillRect(0, 0, width, height);
    }

    raf = requestAnimationFrame(frame);
  }

  function start(detail: WarpDetail) {
    if (phase !== 'idle') return;
    if (document.visibilityState !== 'visible') {
      window.location.assign(detail.href);
      return;
    }
    canvas = document.getElementById('pyuyi-warp') as HTMLCanvasElement | null;
    ctx = canvas?.getContext('2d') ?? null;
    if (!canvas || !ctx) {
      window.location.assign(detail.href);
      return;
    }
    resize();
    accent = detail.color || '#ffd27a';
    origin = { x: detail.x, y: detail.y };
    const reach = Math.hypot(window.innerWidth, window.innerHeight) / 2;
    const count = Math.round(Math.min(560, (window.innerWidth * window.innerHeight) / 2400));
    streaks = Array.from({ length: count }, () => spawn(reach, true));
    motes = createMotes(window.innerWidth < 640 ? 70 : 140);
    arrived = false;
    startedAt = performance.now();
    lastFrame = startedAt;
    enter('aim', startedAt);
    canvas.style.opacity = '1';
    aimCamera(detail);
    raf = requestAnimationFrame(frame);

    const from = window.location.href;
    window.setTimeout(() => {
      fetch(detail.href, { credentials: 'same-origin' }).catch(() => undefined);
    }, PREFETCH_AT_MS);
    window.setTimeout(() => {
      navigate(detail.href).catch(() => window.location.assign(detail.href));
      hardNavigation = window.setTimeout(() => {
        if (!arrived && window.location.href === from) window.location.assign(detail.href);
      }, HARD_NAVIGATION_MS);
    }, NAVIGATE_AT_MS);
    watchdog = window.setTimeout(finish, WATCHDOG_MS);
  }

  window.addEventListener('pyuyi:warp', (event) => {
    const detail = (event as CustomEvent<WarpDetail>).detail;
    if (detail?.href) start(detail);
  });
  window.addEventListener('resize', () => {
    if (phase !== 'idle') resize();
  });
  document.addEventListener('astro:page-load', () => {
    arrived = true;
    // The zoomed <main> was replaced by the new page; forget it.
    zoomed = null;
  });
</script>

<style>
  .pyuyi-warp {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    opacity: 0;
    /* Its own view-transition group keeps the streaks on top while the page swaps underneath. */
    view-transition-name: pyuyi-warp;
  }
</style>
