---
import { getResponsiveMedia } from '@/lib/media';

interface Props {
  src: string;
  alt: string;
  class?: string;
  pictureClass?: string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  class: className,
  pictureClass,
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  loading = 'lazy',
  fetchpriority,
} = Astro.props;
const media = getResponsiveMedia(src);
const placeholderStyle = media.lqip ? `background-image:url('${media.lqip}')` : undefined;
---

<picture class:list={['block bg-cover bg-center', pictureClass]} style={placeholderStyle}>
  {media.avifSrcset && <source type="image/avif" srcset={media.avifSrcset} sizes={sizes} />}
  {media.webpSrcset && <source type="image/webp" srcset={media.webpSrcset} sizes={sizes} />}
  <img
    src={media.fallback}
    srcset={media.webpSrcset}
    sizes={sizes}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
</picture>
