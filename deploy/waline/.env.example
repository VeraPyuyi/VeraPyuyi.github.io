SITE_NAME=Pyuyi's Home
SITE_URL=https://verapyuyi.github.io
SERVER_URL=https://pyuyi-comments.vercel.app

# Require an account before any comment can be submitted.
LOGIN=force

# Protocols are omitted in the allowlist.
SECURE_DOMAINS=verapyuyi.github.io,pyuyi-comments.vercel.app
IPQPS=60
COMMENT_AUDIT=true

# Keep visitor metadata out of the public comment UI.
DISABLE_USERAGENT=true
DISABLE_REGION=true

# The site already renders paper math; comments do not need server-side TeX.
MARKDOWN_TEX=false

# The Neon integration injects this automatically as an owner connection. It is
# only a fallback; production should use the complete least-privilege PG_* set.
DATABASE_URL=

# Waline runtime role. PG_* takes precedence over DATABASE_URL, and all four
# required fields must be configured together. Never commit real passwords.
PG_HOST=
PG_PORT=5432
PG_DB=neondb
PG_USER=waline_app
PG_PASSWORD=
PG_SSL=true
